{
  "name": "galaxy-hub",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "preprocess": "node src/build/preprocess.mjs",
    "preprocess:verbose": "node src/build/preprocess.mjs --verbose",
    "search-index": "node src/build/generate-search-index.mjs",
    "generate-redirects": "node src/build/generate-redirects.mjs",
    "generate-404-lookup": "node src/build/generate-404-lookup.mjs",
    "release-guardians:sync-event": "node src/build/release-guardians-sync-event.mjs",
    "dev": "npm run preprocess && npm run generate-redirects && npm run search-index && npm run generate-404-lookup && (trap 'kill 0' EXIT; node src/build/preprocess.mjs --watch-only & ASTRO_DEV_BACKGROUND=0 astro dev)",
    "build": "npm run preprocess && npm run generate-redirects && npm run search-index && npm run generate-404-lookup && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "links:internal": "node src/build/check-links.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{js,mjs,ts,vue,astro,css}'",
    "format:check": "prettier --check 'src/**/*.{js,mjs,ts,vue,astro,css}'",
    "normalize": "node src/build/normalize-content.mjs",
    "content:lint": "node src/build/normalize-content.mjs --all --check && node src/build/check-dir-names.mjs && node src/build/check-filename-case.mjs && node src/build/check-titles.mjs && node src/build/check-fragment-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.1",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@galaxyproject/brand-tokens": "^0.1.0",
    "@lucide/vue": "^1.59.0",
    "@nanostores/vue": "^1.0.1",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "lucide-static": "^1.59.0",
    "marked": "^18.1.1",
    "nanostores": "^1.5.5",
    "ol": "^10.11.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "reka-ui": "^2.11.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-toc": "^9.0.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
