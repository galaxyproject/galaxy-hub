---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/layout/Sidebar.astro';
import MobileMenu from '../components/layout/MobileMenu.vue';
import SkipLink from '../components/layout/SkipLink.astro';
import { detectSubsiteFromPath } from '../stores/subsiteStore';
import { getSubsiteNavbar } from '../utils/navbar-content';
import Icon from '../components/mdx/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Galaxy Community Hub' } = Astro.props;
const currentSubsite = detectSubsiteFromPath(Astro.url.pathname);
const navbar = await getSubsiteNavbar(currentSubsite);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Galaxy Hub</title>

    <!-- Open Graph / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <SkipLink />
    <div class="site-shell flex min-h-screen overflow-hidden">
      <!-- Sidebar (desktop only) -->
      <Sidebar transition:persist navbar={navbar} initialSubsite={currentSubsite} />

      <!-- Mobile header with Vue-powered menu -->
      <header
        class="site-mobile-header lg:hidden fixed top-0 left-0 right-0 z-50 bg-galaxy-dark p-4 flex items-center justify-between"
      >
        <a href="/" class="block">
          <img src="/images/galaxy_logo_hub_white.svg" alt="Galaxy Community Hub" class="h-8 w-auto" />
        </a>
        <MobileMenu client:load navbar={navbar} initialSubsite={currentSubsite} />
      </header>

      <!-- Main content area -->
      <div class="site-main flex-1 flex flex-col min-h-screen lg:ml-64 pt-22 lg:pt-0 min-w-0 overflow-x-hidden">
        <main id="main-content" tabindex="-1" class="site-content flex-1 p-4 sm:p-6 lg:p-8 bg-light-bg bg-grid">
          <slot />
        </main>

        <!-- Footer -->
        <footer class="site-footer bg-galaxy-dark text-white py-8 px-4 sm:px-6 lg:px-8">
          <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
            <div>
              <h2 class="text-lg font-semibold text-galaxy-gold mb-4">Galaxy Project</h2>
              <p class="text-sm text-chicago-300">
                Open source platform for accessible, reproducible, and transparent data analysis.
              </p>
            </div>
            <div>
              <h2 class="font-semibold mb-3">Resources</h2>
              <ul class="space-y-2 text-sm text-chicago-300">
                <li><a href="/use/" class="hover:text-galaxy-gold">Use Galaxy</a></li>
                <li><a href="https://training.galaxyproject.org" class="hover:text-galaxy-gold">Training</a></li>
                <li><a href="https://docs.galaxyproject.org" class="hover:text-galaxy-gold">Documentation</a></li>
              </ul>
            </div>
            <div>
              <h2 class="font-semibold mb-3">Community</h2>
              <ul class="space-y-2 text-sm text-chicago-300">
                <li><a href="/news/" class="hover:text-galaxy-gold">News</a></li>
                <li><a href="/events/" class="hover:text-galaxy-gold">Events</a></li>
                <li><a href="/community/" class="hover:text-galaxy-gold">Get Involved</a></li>
              </ul>
            </div>
            <div>
              <h2 class="font-semibold mb-3">Connect</h2>
              <div class="flex gap-3">
                <a
                  href="https://github.com/galaxyproject"
                  class="text-chicago-300 hover:text-galaxy-gold"
                  aria-label="GitHub"
                >
                  <Icon name="github" size={24} />
                </a>
                <a
                  href="https://mstdn.science/@galaxyproject"
                  class="text-chicago-300 hover:text-galaxy-gold"
                  aria-label="Mastodon"
                >
                  <Icon name="mastodon" size={24} />
                </a>
              </div>
            </div>
          </div>
          <div class="max-w-7xl mx-auto mt-8 pt-6 border-t border-ebony-clay-700 text-center text-sm text-chicago-400">
            <p>&copy; {new Date().getFullYear()} Galaxy Project. All rights reserved.</p>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
