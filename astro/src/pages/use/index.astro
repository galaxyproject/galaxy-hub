---
import { getListedCollection } from '../../utils/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformDirectory from '../../components/platforms/PlatformDirectory.vue';
import ServerCard from '../../components/use/ServerCard.astro';
import LinkTile from '../../components/use/LinkTile.astro';
import MapToggle from './map/MapToggle.vue';
import { prepareMapPlatformData } from './map/mapDataUtils';
import { loadToolNames, loadReferenceNames } from '../../utils/platformDatasets';
import { renderMarkdownTeaser } from '../../utils/markdown';

// Get all platforms
const platforms = await getListedCollection('platforms');

// Transform platforms to the format expected by the Vue component
const platformData = platforms
  .map((p) => ({
    slug: p.data.slug,
    title: p.data.title || 'Galaxy Server',
    url: p.data.url,
    scope: p.data.scope,
    summary: p.data.summary,
    summaryHtml: renderMarkdownTeaser(p.data.summary),
    platforms: p.data.platforms,
    image: p.data.image,
  }))
  .sort((a, b) => {
    const titleA = a.title.toLowerCase();
    const titleB = b.title.toLowerCase();
    if (titleA < titleB) return -1;
    if (titleA > titleB) return 1;
    return 0;
  });

const mapPlatformData = prepareMapPlatformData(platforms);

// Additive tool:/reference: search data: map each tool/reference (genome) name to
// the platform slugs that provide it. Leaves platformData's shape untouched.
const toolIndex: Record<string, string[]> = {};
const referenceIndex: Record<string, string[]> = {};
for (const p of platforms) {
  for (const name of loadToolNames(p.data.slug)) {
    (toolIndex[name] ??= []).push(p.data.slug);
  }
  for (const name of loadReferenceNames(p.data.slug)) {
    (referenceIndex[name] ??= []).push(p.data.slug);
  }
}

// Main servers: logos come from the platform pages' `image` field; usegalaxy.ca has no logo yet.
const platformImage = (slug: string) => platforms.find((p) => p.data.slug === slug)?.data.image;
const mainServers = [
  {
    name: 'UseGalaxy.org',
    description: 'The main US Galaxy server hosted at Penn State and Johns Hopkins. Free for everyone.',
    href: 'https://usegalaxy.org',
    logo: platformImage('use/usegalaxy-org'),
    detailsHref: '/use/usegalaxy-org/',
  },
  {
    name: 'UseGalaxy.eu',
    description: 'The European Galaxy server at Freiburg with extensive tools and training support.',
    href: 'https://usegalaxy.eu',
    logo: platformImage('use/usegalaxy-eu'),
    detailsHref: '/use/usegalaxy-eu/',
  },
  {
    name: 'UseGalaxy.org.au',
    description: 'Galaxy Australia serving the Oceania region with local support.',
    href: 'https://usegalaxy.org.au',
    logo: platformImage('use/usegalaxy-au'),
    detailsHref: '/use/usegalaxy-au/',
  },
  {
    name: 'UseGalaxy.ca',
    description: 'The Canadian Galaxy server for general purpose analysis.',
    href: 'https://usegalaxy.ca',
    mark: 'CA',
    detailsHref: '/use/usegalaxy-ca/',
  },
];
---

<BaseLayout title="Use Galaxy" description="Find a Galaxy server to analyze your data">
  <div class="max-w-7xl mx-auto">
    <!-- Hero Section -->
    <header class="mb-10 pt-2">
      <h1 class="text-h1 font-bold tracking-tight text-fg-strong">Use Galaxy</h1>
      <p class="mt-2 text-lead text-fg-2">
        Galaxy is available in many forms. Find the right server for your research from {platforms.length}+ options
        worldwide.
      </p>
      <div class="mt-6 border-t border-line" aria-hidden="true">
        <span class="-mt-px block h-0.5 w-12 bg-accent-gold"></span>
      </div>
    </header>

    <!-- Main UseGalaxy Servers -->
    <section class="mb-12">
      <h2 class="mb-4 border-b border-line pb-2 text-h2 font-bold text-fg-strong">Main UseGalaxy Servers</h2>
      <p class="mb-6 text-fg-2">
        The main public Galaxy servers are free for everyone. Start here for general-purpose genomic analysis.
      </p>

      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {mainServers.map((server) => (
          <ServerCard {...server} />
        ))}
      </ul>

      <MapToggle client:only="vue" platforms={mapPlatformData} />
    </section>

    <!-- All Servers Directory -->
    <section>
      <h2 class="mb-4 border-b border-line pb-2 text-h2 font-bold text-fg-strong">All Galaxy Servers</h2>
      <p class="mb-6 text-fg-2">
        Beyond the main UseGalaxy servers, there are hundreds of specialized Galaxy instances for specific domains,
        geographic regions, and research areas. Use the filters below to find the right one for your needs.
      </p>

      <PlatformDirectory
        client:only="vue"
        platforms={platformData}
        toolIndex={toolIndex}
        referenceIndex={referenceIndex}
      />
    </section>

    <!-- Additional Resources -->
    <section class="mt-12">
      <h2 class="mb-4 border-b border-line pb-2 text-h2 font-bold text-fg-strong">Other Ways to Use Galaxy</h2>
      <p class="mb-6 text-fg-2">Can't find what you need? There are more options for running Galaxy.</p>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-3">
        <LinkTile
          href="/admin/"
          icon="server"
          title="Run Your Own"
          description="Install and configure Galaxy on your own infrastructure."
        />
        <LinkTile
          href="/cloud/"
          icon="globe"
          title="Cloud Deployments"
          description="Deploy Galaxy on AWS, GCP, Azure, or other cloud platforms."
        />
        <LinkTile
          href="https://training.galaxyproject.org/"
          icon="book-open"
          title="Galaxy Training"
          description="Learn how to use Galaxy with our extensive tutorial library."
          external
        />
      </ul>
    </section>
  </div>
</BaseLayout>
