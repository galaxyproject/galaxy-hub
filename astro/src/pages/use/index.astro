---
import { getListedCollection } from '../../utils/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformDirectory from '../../components/platforms/PlatformDirectory.vue';
import LinkTile from '../../components/use/LinkTile.astro';
import MapToggle from './map/MapToggle.vue';
import { prepareMapPlatformData } from './map/mapDataUtils';
import { loadToolNames, loadReferenceNames } from '../../utils/platformDatasets';
import { renderMarkdownInline } from '../../utils/markdown';

// Get all platforms
const platforms = await getListedCollection('platforms');

// Transform platforms to the format expected by the Vue component
const platformData = platforms
  .map((p) => ({
    slug: p.data.slug,
    title: p.data.title || 'Galaxy Server',
    url: p.data.url,
    scope: p.data.scope,
    summary: p.data.summary,
    summaryHtml: renderMarkdownInline(p.data.summary),
    platforms: p.data.platforms,
    image: p.data.image,
  }))
  .sort((a, b) => {
    const titleA = a.title.toLowerCase();
    const titleB = b.title.toLowerCase();
    if (titleA < titleB) return -1;
    if (titleA > titleB) return 1;
    return 0;
  });

const mapPlatformData = prepareMapPlatformData(platforms);

// Additive tool:/reference: search data: map each tool/reference (genome) name to
// the platform slugs that provide it. Leaves platformData's shape untouched.
const toolIndex: Record<string, string[]> = {};
const referenceIndex: Record<string, string[]> = {};
for (const p of platforms) {
  for (const name of loadToolNames(p.data.slug)) {
    (toolIndex[name] ??= []).push(p.data.slug);
  }
  for (const name of loadReferenceNames(p.data.slug)) {
    (referenceIndex[name] ??= []).push(p.data.slug);
  }
}
---

<BaseLayout title="Use Galaxy" description="Find a Galaxy server to analyze your data">
  <div class="max-w-7xl mx-auto">
    <!-- Hero Section -->
    <header class="mb-10 pt-2">
      <h1 class="text-h1 font-bold tracking-tight text-fg-strong">Use Galaxy</h1>
      <p class="mt-2 text-lead text-fg-2">
        Galaxy is available in many forms. Find the right server for your research from {platforms.length}+ options
        worldwide.
      </p>
      <div class="mt-6 border-t border-line" aria-hidden="true">
        <span class="-mt-px block h-0.5 w-12 bg-accent-gold"></span>
      </div>
    </header>

    <!-- Main UseGalaxy Servers -->
    <section class="mb-12">
      <h2 class="mb-[1rem] border-b border-line pb-2 text-h2 font-bold text-fg-strong">Main UseGalaxy Servers</h2>
      <p class="mb-6 text-fg-2">
        The main public Galaxy servers are free for everyone. Start here for general-purpose genomic analysis.
      </p>

      <!-- UseGalaxy.* -->
      <div class="bg-white rounded-lg shadow-sm border border-ebony-clay-100 p-6 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
          <a
            href="https://usegalaxy.org"
            target="_blank"
            rel="noopener"
            class="flex flex-col justify-between h-full p-6 bg-gradient-to-br from-galaxy-primary to-galaxy-dark text-white rounded-lg hover:shadow-md transition-shadow"
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold">UseGalaxy.org</h3>
              </div>
              <p class="text-white/90 text-sm mb-4">
                The main US Galaxy server hosted at Penn State and Johns Hopkins. Free for everyone.
              </p>
            </div>
            <div class="flex items-center text-sm">
              <span class="text-galaxy-accent font-medium">Start analyzing</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </div>
          </a>

          <a
            href="https://usegalaxy.eu"
            target="_blank"
            rel="noopener"
            class="flex flex-col justify-between h-full p-6 bg-gradient-to-br from-blue-600 to-blue-800 text-white rounded-lg hover:shadow-md transition-shadow"
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold">UseGalaxy.eu</h3>
              </div>
              <p class="text-white/90 text-sm mb-4">
                The European Galaxy server at Freiburg with extensive tools and training support.
              </p>
            </div>
            <div class="flex items-center text-sm">
              <span class="text-green-300 font-medium">Start analyzing</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </div>
          </a>

          <a
            href="https://usegalaxy.org.au"
            target="_blank"
            rel="noopener"
            class="flex flex-col justify-between h-full p-6 bg-gradient-to-br from-orange-500 to-red-600 text-white rounded-lg hover:shadow-md transition-shadow"
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold">UseGalaxy.org.au</h3>
              </div>
              <p class="text-white/90 text-sm mb-4">Galaxy Australia serving the Oceania region with local support.</p>
            </div>
            <div class="flex items-center text-sm">
              <span class="text-yellow-300 font-medium">Start analyzing</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </div>
          </a>

          <a
            href="https://usegalaxy.ca"
            target="_blank"
            rel="noopener"
            class="flex flex-col justify-between h-full p-6 bg-gradient-to-br from-red-600 to-red-800 text-white rounded-lg hover:shadow-md transition-shadow"
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold">UseGalaxy.ca</h3>
              </div>
              <p class="text-white/90 text-sm mb-4">The Canadian Galaxy server for general purpose analysis.</p>
            </div>
            <div class="flex items-center text-sm">
              <span class="text-red-200 font-medium">Start analyzing</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </div>
          </a>
        </div>

        <MapToggle client:only="vue" platforms={mapPlatformData} />
      </div>
    </section>

    <!-- All Servers Directory -->
    <section>
      <h2 class="mb-[1rem] border-b border-line pb-2 text-h2 font-bold text-fg-strong">All Galaxy Servers</h2>
      <p class="mb-6 text-fg-2">
        Beyond the main UseGalaxy servers, there are hundreds of specialized Galaxy instances for specific domains,
        geographic regions, and research areas. Use the filters below to find the right one for your needs.
      </p>

      <PlatformDirectory
        client:only="vue"
        platforms={platformData}
        toolIndex={toolIndex}
        referenceIndex={referenceIndex}
      />
    </section>

    <!-- Additional Resources -->
    <section class="mt-12">
      <h2 class="mb-[1rem] border-b border-line pb-2 text-h2 font-bold text-fg-strong">Other Ways to Use Galaxy</h2>
      <p class="mb-6 text-fg-2">Can't find what you need? There are more options for running Galaxy.</p>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-4 p-0">
        <LinkTile
          href="/admin/"
          icon="server"
          title="Run Your Own"
          description="Install and configure Galaxy on your own infrastructure."
        />
        <LinkTile
          href="/cloud/"
          icon="globe"
          title="Cloud Deployments"
          description="Deploy Galaxy on AWS, GCP, Azure, or other cloud platforms."
        />
        <LinkTile
          href="https://training.galaxyproject.org/"
          icon="book-open"
          title="Galaxy Training"
          description="Learn how to use Galaxy with our extensive tutorial library."
          external
        />
      </ul>
    </section>
  </div>
</BaseLayout>
