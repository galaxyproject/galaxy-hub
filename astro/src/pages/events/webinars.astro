---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListedCollection } from '../../utils/content';
import EventDate from '@/components/events/EventDate.astro';
import { isUpcomingEvent, isPastEvent } from '../../utils/dateUtils';

const tag = 'webinar';
const pageTitle = 'Galaxy Webinars';
const pageDescription = 'Galaxy community webinars - online presentations and training sessions';

// Get events with this tag
const allEvents = await getListedCollection('events');
const taggedEvents = allEvents.filter((event) => {
  const tags = event.data.tags;
  if (!tags) return false;
  const tagArray = Array.isArray(tags) ? tags : [tags];
  return tagArray.some((t) => t.toLowerCase().trim() === tag.toLowerCase());
});

const now = new Date();

// Split into upcoming and past
const upcomingEvents = taggedEvents
  .filter((e) => isUpcomingEvent(e.data.date, e.data.end, now))
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date || '');
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date || '');
    return dateA.getTime() - dateB.getTime();
  });

const pastEvents = taggedEvents
  .filter((e) => isPastEvent(e.data.date, e.data.end, now))
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date || '');
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date || '');
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 50);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-fg-strong mb-2">{pageTitle}</h1>
      <p class="text-fg-meta">{pageDescription}</p>
    </div>

    <!-- Upcoming Webinars -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-fg-strong mb-4">
        Upcoming Webinars
        <span class="text-sm font-normal text-fg-meta ml-2">({upcomingEvents.length})</span>
      </h2>

      {upcomingEvents.length === 0 ? (
        <p class="text-fg-meta italic">No upcoming webinars scheduled. Check back soon!</p>
      ) : (
        <div class="space-y-4">
          {upcomingEvents.map((event) => <a
            href={`/${event.data.slug}/`}
            class="block p-4 bg-surface rounded-lg border border-line hover:border-galaxy-primary hover:shadow-md transition-all"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-semibold text-fg-strong hover:text-link">{event.data.title}</h3>
                <p class="text-sm mt-1">
                  <EventDate start={event.data.date} end={event.data.end} />
                </p>
                {event.data.tease && <p class="text-fg-meta text-sm mt-1 line-clamp-2">{event.data.tease}</p>}
              </div>
            </div>
          </a>)}
        </div>
      )}
    </section>

    <!-- Past Webinars -->
    <section>
      <h2 class="text-2xl font-bold text-fg-strong mb-4">
        Past Webinars
        <span class="text-sm font-normal text-fg-meta ml-2">(recent {pastEvents.length})</span>
      </h2>

      {pastEvents.length === 0 ? (
        <p class="text-fg-meta italic">No past webinars found.</p>
      ) : (
        <div class="space-y-2">
          {pastEvents.map((event) => <a
            href={`/${event.data.slug}/`}
            class="flex flex-col md:flex-row md:items-center gap-1 md:gap-3 p-3 bg-surface-chip rounded-lg hover:bg-surface-chip transition-colors"
          >
            <span class="text-sm min-w-24 shrink-0">
              <EventDate start={event.data.date} end={event.data.end} past />
            </span>
            <span class="text-fg-2 hover:text-link">{event.data.title}</span>
          </a>)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
