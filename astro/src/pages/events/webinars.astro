---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListedCollection } from '../../utils/content';
import EventRow from '@/components/lists/EventRow.astro';
import { isUpcomingEvent, isPastEvent } from '../../utils/dateUtils';

const tag = 'webinar';
const pageTitle = 'Galaxy Webinars';
const pageDescription = 'Galaxy community webinars - online presentations and training sessions';

// Get events with this tag
const allEvents = await getListedCollection('events');
const taggedEvents = allEvents.filter((event) => {
  const tags = event.data.tags;
  if (!tags) return false;
  const tagArray = Array.isArray(tags) ? tags : [tags];
  return tagArray.some((t) => t.toLowerCase().trim() === tag.toLowerCase());
});

const now = new Date();

// Split into upcoming and past
const upcomingEvents = taggedEvents
  .filter((e) => isUpcomingEvent(e.data.date, e.data.end, now))
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date || '');
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date || '');
    return dateA.getTime() - dateB.getTime();
  });

const pastEvents = taggedEvents
  .filter((e) => isPastEvent(e.data.date, e.data.end, now))
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date || '');
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date || '');
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 50);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-galaxy-dark mb-2">{pageTitle}</h1>
      <p class="text-chicago-600">{pageDescription}</p>
    </div>

    <!-- Upcoming Webinars -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-galaxy-dark mb-4">
        Upcoming Webinars
        <span class="text-sm font-normal text-chicago-500 ml-2">({upcomingEvents.length})</span>
      </h2>

      {upcomingEvents.length === 0 ? (
        <p class="text-chicago-500 italic">No upcoming webinars scheduled. Check back soon!</p>
      ) : (
        <div>
          {upcomingEvents.map((event) => (
            <EventRow
              href={`/${event.data.slug}/`}
              title={event.data.title}
              start={event.data.date}
              end={event.data.end}
              tease={event.data.tease}
            />
          ))}
        </div>
      )}
    </section>

    <!-- Past Webinars -->
    <section>
      <h2 class="text-2xl font-bold text-galaxy-dark mb-4">
        Past Webinars
        <span class="text-sm font-normal text-chicago-500 ml-2">(recent {pastEvents.length})</span>
      </h2>

      {pastEvents.length === 0 ? (
        <p class="text-chicago-500 italic">No past webinars found.</p>
      ) : (
        <div>
          {pastEvents.map((event) => (
            <EventRow
              href={`/${event.data.slug}/`}
              title={event.data.title}
              start={event.data.date}
              end={event.data.end}
              past
            />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
