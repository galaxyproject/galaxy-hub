---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListedCollection } from '../../utils/content';
import EventRow from '../../components/lists/EventRow.astro';
import { getUTCYear, utcDayOneYearAgo } from '../../utils/dateUtils';

// Get all events, sorted by date descending
const events = await getListedCollection('events');
const now = new Date();
const oneYearAgo = utcDayOneYearAgo(now);

// Archive = events older than 1 year
const archivedEvents = events
  .filter((event) => {
    const eventDate = event.data.date instanceof Date ? event.data.date : new Date(event.data.date || '');
    return eventDate < oneYearAgo;
  })
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date || '');
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date || '');
    return dateB.getTime() - dateA.getTime();
  });

// Group by year
const eventsByYear = archivedEvents.reduce(
  (acc, event) => {
    const date = event.data.date instanceof Date ? event.data.date : new Date(event.data.date || '');
    const year = getUTCYear(date);
    if (!acc[year]) acc[year] = [];
    acc[year].push(event);
    return acc;
  },
  {} as Record<number, typeof archivedEvents>
);

const years = Object.keys(eventsByYear)
  .map(Number)
  .sort((a, b) => b - a);

function getLocationName(location: any): string {
  if (!location) return '';
  if (typeof location === 'string') return location;
  return location.name || '';
}
---

<BaseLayout title="Events Archive" description="Archive of past Galaxy community events">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-galaxy-dark mb-2">Events Archive</h1>
      <p class="text-chicago-600">
        Historical record of Galaxy community events. For recent and upcoming events, see the
        <a href="/events/" class="text-galaxy-primary hover:underline">main events page</a>.
      </p>
      <p class="text-sm text-chicago-500 mt-2">Showing {archivedEvents.length} events from {years.length} years</p>
    </div>

    {years.map((year) => <section aria-labelledby={`archive-${year}`}>
      <h2 id={`archive-${year}`} class="gx-year-head">
        {year}
        <span class="gx-year-head__count">{eventsByYear[year].length}<span class="sr-only"> events</span></span>
      </h2>
      <ol class="gx-lrows">
        {eventsByYear[year].map((event) => (
          <EventRow
            href={`/${event.data.slug}/`}
            title={event.data.title}
            start={event.data.date}
            end={event.data.end}
            format={{ year: false }}
            location={getLocationName(event.data.location)}
            tags={Array.isArray(event.data.tags) ? event.data.tags.slice(0, 2) : []}
            externalUrl={(event.data as any).external_url}
            past
          />
        ))}
      </ol>
    </section>)}

    {archivedEvents.length === 0 && <p class="text-chicago-500 italic text-center py-12">No archived events found.</p>}
  </div>
</BaseLayout>
