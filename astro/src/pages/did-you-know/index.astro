---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import DidYouKnowCard, { type DykItem } from '../../components/did-you-know/DidYouKnowCard.vue';
import { getDidYouKnow } from '../../utils/did-you-know-server';
import { toSerializable } from '../../utils/did-you-know';

const items = await getDidYouKnow('global');
const serialized: DykItem[] = items.map(toSerializable);
---

<BaseLayout title="Did You Know" description="Tips and tricks for getting more out of Galaxy.">
  <div class="max-w-6xl mx-auto">
    <PageHeader
      title="Did You Know"
      description="Bite-sized tips and tricks for getting more out of Galaxy. Each visit shows a fresh image and link — come back often!"
    />

    <div class="bg-white px-6 sm:px-8 py-6 rounded-b-lg shadow-sm">
      {
        serialized.length > 0 ? (
          <div class="dyk-grid">
            {serialized.map((item) => (
              <DidYouKnowCard client:load item={item} />
            ))}
          </div>
        ) : (
          <p>No tips are available yet.</p>
        )
      }

      <p class="dyk-bare-note">
        Looking for an embeddable version? See the
        <a href="/bare/did-you-know/">bare page</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .dyk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .dyk-bare-note {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: #64748b;
  }

  .dyk-bare-note a {
    color: #25537b;
    text-decoration: none;
  }

  .dyk-bare-note a:hover {
    text-decoration: underline;
  }
</style>
