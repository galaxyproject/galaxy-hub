---
/** Embeddable latest news feed of ESG4Stars; the same section as #news on /projects/esg4stars/. */
import Esg4StarsBarePart from '@/components/projects/esg4stars/Esg4StarsBarePart.astro';
import ProjectRows from '@/components/projects/ProjectRows.astro';
import ProjectSection from '@/components/projects/ProjectSection.astro';
import { getEsg4StarsOverview } from '@/utils/esg4starsOverview';

const { project, newsRows, newsCount, newsHref } = await getEsg4StarsOverview();
---

<Esg4StarsBarePart title={`News - ${project.name}`} anchor="news">
  <ProjectSection
    id="news"
    title="News"
    more={{ href: newsHref, label: `All ${newsCount} news`, context: `from ${project.name}` }}
  >
    {newsRows.length > 0 ? (
      <ProjectRows kind="news" items={newsRows} />
    ) : (
      <p class="text-chicago-700 text-sm">No news articles yet.</p>
    )}
  </ProjectSection>
</Esg4StarsBarePart>
