---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import type { CollectionEntry } from 'astro:content';
import { getListedCollection } from '../../utils/content';
import { extractAuthors, extractFunding } from '../../utils/contributors';
import { addDirectoryContributor, type DirectoryContributor } from '../../utils/hallOfFameDirectory';

type NewsEntry = CollectionEntry<'news'>;
type EventEntry = CollectionEntry<'events'>;

function normalizeEntry(entry: NewsEntry | EventEntry): { authors: string[]; supporters: string[] } {
  const data = entry.data as Record<string, unknown>;
  const authors = extractAuthors(data);
  const supporters = extractFunding(data);
  return { authors, supporters };
}

const [newsArticles, events] = await Promise.all([getListedCollection('news'), getListedCollection('events')]);

const authorMap = new Map<string, DirectoryContributor>();
const supporterMap = new Map<string, DirectoryContributor>();

const collect = (entry: NewsEntry | EventEntry) => {
  const { authors, supporters } = normalizeEntry(entry);
  authors.forEach((id) => addDirectoryContributor(authorMap, id));
  supporters.forEach((id) => addDirectoryContributor(supporterMap, id));
};

newsArticles.forEach(collect);
events.forEach(collect);

const authors = Array.from(authorMap.values()).sort((a, b) => a.name.localeCompare(b.name));
const supporters = Array.from(supporterMap.values()).sort((a, b) => a.name.localeCompare(b.name));

const totalAuthors = authors.length;
const totalSupporters = supporters.length;
const totalContributions =
  authors.reduce((sum, a) => sum + a.count, 0) + supporters.reduce((sum, s) => sum + s.count, 0);

function groupContributors(items: DirectoryContributor[]) {
  const groups: Record<string, DirectoryContributor[]> = {};
  for (const item of items) {
    const firstChar = (item.name || '').charAt(0).toUpperCase();
    const letter = /^[A-Z]$/.test(firstChar) ? firstChar : 'Other';
    if (!groups[letter]) groups[letter] = [];
    groups[letter].push(item);
  }
  for (const letter of Object.keys(groups)) {
    groups[letter].sort((a, b) => a.name.localeCompare(b.name));
  }
  const letters = Object.keys(groups).sort();
  return { letters, groups };
}

const authorGroups = groupContributors(authors);
const supporterGroups = groupContributors(supporters);
---

<BaseLayout title="Hall of Fame" description="Discover contributors across Galaxy news and events">
  <div class="max-w-6xl mx-auto">
    <PageHeader title="Hall of Fame" description="Browse every author and supporter credited across news and events.">
      <div class="flex flex-wrap gap-6 mt-6">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-galaxy-gold">{totalAuthors}</span>
          <span class="text-white/60 text-sm uppercase tracking-wide">Authors</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-galaxy-gold">{totalSupporters}</span>
          <span class="text-white/60 text-sm uppercase tracking-wide">Supporters</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-galaxy-gold">{totalContributions.toLocaleString()}</span>
          <span class="text-white/60 text-sm uppercase tracking-wide">Credits</span>
        </div>
      </div>
    </PageHeader>

    <nav
      class="bg-surface border-b border-line px-8 py-3 sticky top-0 z-20 shadow-sm"
      aria-label="Hall of Fame sections"
    >
      <div class="flex flex-wrap gap-2">
        <a
          href="#authors"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line text-sm font-medium text-link hover:border-galaxy-gold hover:bg-galaxy-gold/10 transition-colors"
        >
          Authors
        </a>
        <a
          href="#supporters"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line text-sm font-medium text-link hover:border-galaxy-gold hover:bg-galaxy-gold/10 transition-colors"
        >
          Supporters
        </a>
      </div>
    </nav>

    <div class="bg-surface px-8 py-6 rounded-b-lg shadow-sm space-y-12">
      <section id="authors" class="scroll-mt-24">
        <div class="flex items-center gap-4 mb-4">
          <h2 class="text-2xl font-semibold text-fg-strong">Authors</h2>
          <span class="text-sm text-fg-meta">{totalAuthors} contributors</span>
        </div>

        {authorGroups.letters.length > 0 ? (
          <>
            <div class="flex flex-wrap gap-1 mb-4">
              {authorGroups.letters.map((letter) => <a
                href={`#authors-${letter}`}
                class="w-8 h-8 flex items-center justify-center rounded text-sm font-medium text-link hover:bg-galaxy-gold hover:text-fg-strong transition-colors"
              >
                {letter}
              </a>)}
            </div>

            {authorGroups.letters.map((letter, idx) => <section
              id={`authors-${letter}`}
              class={idx > 0 ? 'mt-6 pt-6 border-t border-ebony-clay-50' : ''}
            >
              <div class="flex items-center gap-4 mb-3">
                <span class="text-3xl font-bold text-link/60">{letter}</span>
                <span class="text-xs text-fg-meta">{authorGroups.groups[letter].length} names</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {authorGroups.groups[letter].map((item) => <a
                  href={`/hall-of-fame/${item.slug}/`}
                  data-kind="author"
                  class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line hover:border-galaxy-gold hover:bg-galaxy-gold/5 transition-all duration-200"
                >
                  <span class="text-fg-strong group-hover:text-link transition-colors text-base font-medium">
                    {item.name}
                  </span>
                  <span
                    class="inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1.5 rounded-full bg-surface-chip text-xs text-fg-meta group-hover:bg-galaxy-gold/20 group-hover:text-fg-strong transition-colors"
                  >
                    {item.count}
                  </span>
                </a>)}
              </div>
            </section>)}
          </>
        ) : (
          <p class="text-fg-meta">No authors found.</p>
        )}
      </section>

      <section id="supporters" class="scroll-mt-24">
        <div class="flex items-center gap-4 mb-4">
          <h2 class="text-2xl font-semibold text-fg-strong">Supporters</h2>
          <span class="text-sm text-fg-meta">{totalSupporters} contributors</span>
        </div>

        {supporterGroups.letters.length > 0 ? (
          <>
            <div class="flex flex-wrap gap-1 mb-4">
              {supporterGroups.letters.map((letter) => <a
                href={`#supporters-${letter}`}
                class="w-8 h-8 flex items-center justify-center rounded text-sm font-medium text-link hover:bg-galaxy-gold hover:text-fg-strong transition-colors"
              >
                {letter}
              </a>)}
            </div>

            {supporterGroups.letters.map((letter, idx) => <section
              id={`supporters-${letter}`}
              class={idx > 0 ? 'mt-6 pt-6 border-t border-ebony-clay-50' : ''}
            >
              <div class="flex items-center gap-4 mb-3">
                <span class="text-3xl font-bold text-link/60">{letter}</span>
                <span class="text-xs text-fg-meta">{supporterGroups.groups[letter].length} names</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {supporterGroups.groups[letter].map((item) => <a
                  href={`/hall-of-fame/${item.slug}/`}
                  data-kind="supporter"
                  class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line hover:border-galaxy-gold hover:bg-galaxy-gold/5 transition-all duration-200"
                >
                  <span class="text-fg-strong group-hover:text-link transition-colors text-base font-medium">
                    {item.name}
                  </span>
                  <span
                    class="inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1.5 rounded-full bg-surface-chip text-xs text-fg-meta group-hover:bg-galaxy-gold/20 group-hover:text-fg-strong transition-colors"
                  >
                    {item.count}
                  </span>
                </a>)}
              </div>
            </section>)}
          </>
        ) : (
          <p class="text-fg-meta">No supporters found.</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  [id^='authors-'],
  [id^='supporters-'] {
    scroll-margin-top: 5rem;
  }
</style>
