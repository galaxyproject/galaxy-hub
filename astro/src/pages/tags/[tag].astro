---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { getTagIndex } from '../../utils/tagIndex';
import EventRow from '../../components/lists/EventRow.astro';
import '../../components/lists/list-rows.css';
import { formatDate, isPastEvent } from '../../utils/dateUtils';

export async function getStaticPaths() {
  const index = await getTagIndex();
  return Array.from(index.keys()).map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

// Get articles and events from cached index
const index = await getTagIndex();
const profile = index.get(tag);

// News articles (already sorted by date in index)
const newsArticles = profile?.news || [];

// Events already sorted by date in index
const sortedEvents = profile?.events || [];

const totalItems = newsArticles.length + sortedEvents.length;
const hasBoth = newsArticles.length > 0 && sortedEvents.length > 0;
---

<BaseLayout title={`Tagged: ${tag}`} description={`Content tagged with "${tag}"`}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={tag} description={`${totalItems} ${totalItems === 1 ? 'item' : 'items'} tagged`}>
      <a
        href="/tags/"
        class="inline-flex items-center gap-1.5 text-sm text-white/70 hover:text-galaxy-gold transition-colors mt-4"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        All Tags
      </a>
    </PageHeader>

    <div class="bg-white rounded-b-lg shadow-sm px-6 sm:px-8 py-6">
      {newsArticles.length > 0 || sortedEvents.length > 0 ? (
        <div class:list={['grid grid-cols-1 gap-8', { 'lg:grid-cols-2': hasBoth }]}>
          {newsArticles.length > 0 && <section>
            <h2
              class="flex items-center gap-2 text-lg font-semibold text-galaxy-dark mb-4 pb-2 border-b border-ebony-clay-100"
            >
              <svg class="w-5 h-5 text-chicago-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                />
              </svg>
              News <span class="text-sm font-normal text-chicago-400">({newsArticles.length})</span>
            </h2>
            <ol class="gx-lrows" id="news-list">
              {newsArticles.map((article, idx) => <li class:list={['gx-lrow', { hidden: idx >= 20 }]} data-item>
                <h3 class="gx-lrow__title">
                  <a class="gx-lrow__link" href={`/${article.data.slug}/`}>{article.data.title}</a>
                </h3>
                <p class="gx-lrow__meta"><time>{formatDate(article.data.date)}</time></p>
                {article.data.tease && <p class="gx-lrow__teaser">{article.data.tease}</p>}
              </li>)}
            </ol>
            {newsArticles.length > 20 && <button
              type="button"
              class="mt-4 text-sm text-galaxy-primary hover:text-galaxy-gold transition-colors"
              data-show-more="news-list"
              data-remaining={newsArticles.length - 20}
            >
              Show {newsArticles.length - 20} more
            </button>}
          </section>}

          {sortedEvents.length > 0 && <section>
            <h2
              class="flex items-center gap-2 text-lg font-semibold text-galaxy-dark mb-4 pb-2 border-b border-ebony-clay-100"
            >
              <svg class="w-5 h-5 text-chicago-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              Events <span class="text-sm font-normal text-chicago-400">({sortedEvents.length})</span>
            </h2>
            <ol class="gx-lrows" id="events-list">
              {sortedEvents.map((event, idx) => (
                <EventRow
                  href={`/${event.data.slug}/`}
                  title={event.data.title}
                  start={event.data.date}
                  end={event.data.end}
                  past={isPastEvent(event.data.date, event.data.end)}
                  tease={event.data.tease}
                  externalUrl={event.data.external_url}
                  class={idx >= 20 ? 'hidden' : undefined}
                  data-item
                />
              ))}
            </ol>
            {sortedEvents.length > 20 && <button
              type="button"
              class="mt-4 text-sm text-galaxy-primary hover:text-galaxy-gold transition-colors"
              data-show-more="events-list"
              data-remaining={sortedEvents.length - 20}
            >
              Show {sortedEvents.length - 20} more
            </button>}
          </section>}
        </div>
      ) : (
        <p class="text-chicago-500 text-center py-8">No content found with this tag.</p>
      )}
    </div>
  </div>
</BaseLayout>

<script data-astro-rerun>
  document.querySelectorAll('[data-show-more]').forEach((button) => {
    button.addEventListener('click', () => {
      const listId = button.getAttribute('data-show-more');
      const list = document.getElementById(listId);
      if (list) {
        list.querySelectorAll('[data-item].hidden').forEach((item) => {
          item.classList.remove('hidden');
        });
        button.remove();
      }
    });
  });
</script>
