---
/**
 * Projects index: entries grouped as active project sections (content/projects/<id>/main.md,
 * with their status and dates), then the other project pages under content/projects/, then
 * external project sites, then completed project sections.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Icon from '../../components/mdx/Icon.astro';
import { getEntry } from 'astro:content';
import { getGrant } from '../../utils/contributors';
import { getProjectIndex } from '../../utils/projectPages';
import { groupProjectIndex } from '../../utils/projectIndex';
import { countLabel, projectDuration, projectStatus, statusBadgeLabel } from '../../utils/projectFacts';

const now = new Date();
const projects = (await getProjectIndex(now)).map((project) => ({
  ...project,
  status: project.facts && projectStatus(project.facts, now),
  badge: project.facts && statusBadgeLabel(project.facts, now),
  dates: project.facts && projectDuration(project.facts)?.short,
  host: project.external ? new URL(project.href).host : undefined,
}));
const groups = groupProjectIndex(projects, now);
// Projects Galaxy takes part in that have no page of their own; names and links come from GRANTS.yaml.
const participation = (await getEntry('datasets', 'project-participation'))?.data as
  { heading?: string; intro?: string; grants?: string[] } | undefined;
const alsoTakesPartIn = (participation?.grants ?? [])
  .map((id) => getGrant(id))
  .filter((grant) => grant?.name)
  .sort((a, b) => a!.name!.localeCompare(b!.name!));
const description = 'Projects and community efforts around Galaxy, with their own pages on the Hub.';
const externalCount = projects.filter((project) => project.external).length;
const onHub = `${countLabel(projects.length - externalCount, 'project')} on the Hub`;
const count = externalCount > 0 ? `${onHub}, ${countLabel(externalCount, 'external site')}` : onHub;
---

<BaseLayout title="Projects" description={description}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title="Projects" description={description} />

    <div class="bg-white px-4 sm:px-8 py-6 rounded-b-lg shadow-sm">
      <p class="text-sm text-chicago-700 mb-4" data-project-count>{count}</p>
      <div data-project-index>
        {groups.map((group) => <section class="project-group" data-project-group={group.key}>
          <h2 class="project-group__title">{group.title}</h2>
          <ul class="project-cards">
            {group.items.map((project) => <li class="project-card">
              {(project.badge || project.dates || project.host) && <p class="project-card__meta">
                {project.badge && <span class="project-card__badge" data-project-status={project.status}>
                  {project.badge}
                </span>}
                {project.dates && <span>{project.dates}</span>}
                {project.host && <span>External site · {project.host}</span>}
              </p>}
              <h3 class="project-card__title">
                {project.external ? (
                  <a class="project-card__link" href={project.href} target="_blank" rel="noopener noreferrer">
                    {project.title}
                    <span aria-hidden="true"><Icon name="external-link" size={14} /></span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <a class="project-card__link" href={project.href}>{project.title}</a>
                )}
              </h3>
              {project.description && <p class="project-card__desc">{project.description}</p>}
            </li>)}
          </ul>
        </section>)}
      </div>

      {alsoTakesPartIn.length > 0 && <section class="project-participation">
        <h2 class="project-participation__title">{participation?.heading ?? 'Galaxy also takes part in'}</h2>
        {participation?.intro && <p class="project-participation__intro">{participation.intro}</p>}
        <ul class="project-participation__list">
          {alsoTakesPartIn.map((grant) => <li>
            {grant!.url ? (
              <a href={grant!.url} target="_blank" rel="noopener noreferrer">{grant!.name}</a>
            ) : (
              grant!.name
            )}
          </li>)}
        </ul>
      </section>}
    </div>
  </div>
</BaseLayout>

<style>
  .project-group + .project-group {
    margin-top: 28px;
  }

  .project-group__title {
    margin: 0 0 12px;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-galaxy-grey);
  }

  .project-cards {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  /* Card with one link stretched over it and the gold hover bar on the left edge */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 16px 18px;
    border: 1px solid color-mix(in srgb, var(--color-galaxy-primary) 10%, transparent);
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    transition:
      box-shadow 0.2s,
      border-color 0.2s;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: -1px;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--color-galaxy-gold);
    transform: scaleY(0);
    transition: transform 0.2s;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-chicago-300);
    box-shadow: 0 4px 6px rgb(0 0 0 / 0.08);
  }

  .project-card:hover::before,
  .project-card:focus-within::before {
    transform: scaleY(1);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-galaxy-grey);
  }

  .project-card__badge {
    padding: 0 8px;
    border: 1px solid var(--color-chicago-200);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-chicago-700);
    background: var(--color-chicago-50);
  }

  .project-card__badge[data-project-status='active'] {
    border-color: var(--color-bay-of-many-200);
    color: var(--color-galaxy-primary);
    background: #fff;
  }

  .project-card__title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--color-galaxy-dark);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: inherit;
    text-decoration: none;
  }

  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
  }

  .project-card:hover .project-card__link {
    text-decoration: underline;
    text-decoration-color: var(--color-galaxy-gold);
    text-decoration-thickness: 2px;
  }

  .project-card__link:focus-visible {
    outline: none;
  }

  .project-card:has(.project-card__link:focus-visible) {
    outline: 2px solid var(--color-galaxy-primary);
    outline-offset: 2px;
  }

  .project-participation {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-chicago-200);
  }

  .project-participation__title {
    margin: 0 0 8px;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-galaxy-grey);
  }

  .project-participation__intro {
    margin: 0 0 10px;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-chicago-900);
  }

  .project-participation__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .project-participation__list a {
    color: var(--color-galaxy-primary);
  }

  .project-card__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-chicago-900);
  }
</style>
