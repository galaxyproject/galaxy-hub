---
/**
 * EuroScienceGateway past events. The project has ended, so only past events tagged esg are listed.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectPageTop from '../../../components/projects/ProjectPageTop.astro';
import ProjectRows from '../../../components/projects/ProjectRows.astro';
import ProjectFunding from '../../../components/projects/ProjectFunding.astro';
import { getInsert } from '../../../utils/content';
import { countLabel } from '../../../utils/projectFacts';
import { getProject, getProjectEvents, getProjectNews } from '../../../utils/projectPages';

const project = await getProject('esg', 'partners');
const intro = (await getInsert('projects/esg/events'))?.data as { description?: string } | undefined;
const newsCount = (await getProjectNews(project.source)).length;
const pastEvents = await getProjectEvents(project.source, { pastOnly: true });
---

<BaseLayout
  title={`Past events | ${project.name}`}
  description={intro?.description ?? `Past events of ${project.name}`}
>
  <div class="max-w-6xl mx-auto bg-white rounded-lg shadow-sm p-4 sm:p-6 lg:p-8">
    <ProjectPageTop
      projectId={project.id}
      name={project.name}
      description={project.description}
      facts={project.facts}
      counts={{ '/projects/esg/news/': newsCount }}
      title={`${project.name} past events`}
      lead={intro?.description}
    />

    <section aria-labelledby="past-events-title" class="max-w-4xl">
      <h2 id="past-events-title" class="sr-only">Past events</h2>
      <p class="text-sm text-chicago-700 mb-2">{countLabel(pastEvents.length, 'past event')}, newest first</p>
      {pastEvents.length > 0 ? (
        <ProjectRows
          kind="events"
          items={pastEvents.map((event) => ({
            href: `/${event.data.slug}/`,
            title: event.data.title,
            tease: event.data.tease,
            start: event.data.date,
            end: event.data.end,
          }))}
        />
      ) : (
        <p class="text-chicago-700 text-sm">No past events.</p>
      )}
    </section>

    <ProjectFunding slug="projects/esg/funding_notice" class="mt-10" />
  </div>
</BaseLayout>
