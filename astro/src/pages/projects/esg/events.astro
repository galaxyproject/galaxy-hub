---
/**
 * ESG Events Page
 * Lists events tagged with the ESG subsite
 */
import ESGLayout from '../../../layouts/ESGLayout.astro';
import { getCollection } from 'astro:content';
import { formatDateRange, isPastEvent } from '../../../utils/dateUtils';

// Check for solo mode
const solo = Astro.url.searchParams.get('solo') === 'true';

// Load ESG events
const events = await getCollection('events');
const now = new Date();

// ESG is a project surface, so it intentionally uses narrow project tags rather than subsite-wide matching.
const allEsgEvents = events
  .filter((e) => {
    const subsites = e.data.subsites || [];
    return subsites.includes('esg');
  })
  .sort((a, b) => {
    const dateA = new Date(a.data.date || 0);
    const dateB = new Date(b.data.date || 0);
    return dateA.getTime() - dateB.getTime();
  });

// The ESG project is over, so only past events are listed (newest first).
const pastEvents = allEsgEvents.filter((e) => isPastEvent(e.data.date, e.data.end, now)).reverse();

function esgUrl(path: string): string {
  return solo ? `${path}?solo=true` : path;
}
---

<ESGLayout title="Events" description="Past events from the EuroScienceGateway project" solo={solo}>
  <div class="mb-6">
    <a href={esgUrl('/projects/esg/')} class="text-galaxy-primary hover:underline text-sm"> &larr; Back to ESG Home </a>
  </div>

  <h1 class="text-3xl font-light text-chicago-800 mb-8">EuroScienceGateway Events</h1>

  <!-- Past Events -->
  <section>
    <h2 class="text-2xl font-light text-chicago-700 mb-6">Past Events</h2>
    {pastEvents.length > 0 ? (
      <div class="space-y-3">
        {pastEvents.map((event) => <div class="border-b border-ebony-clay-50 pb-3">
          <div class="flex flex-col md:flex-row md:items-center gap-2">
            <span class="text-chicago-500 text-sm whitespace-nowrap">
              {formatDateRange(event.data.date, event.data.end)}
            </span>
            <a href={`/${event.data.slug}/`} class="text-chicago-700 hover:text-galaxy-gold">
              {event.data.title}
            </a>
          </div>
        </div>)}
      </div>
    ) : (
      <p class="text-chicago-500 text-sm">No past events.</p>
    )}
  </section>
</ESGLayout>
