---
/**
 * EuroScienceGateway project overview, in the main site shell with the project context.
 * Facts come from content/projects/esg/main.md, sections from the ESG datasets.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EsgInteractivePoster from '../../../components/EsgInteractivePoster.astro';
import ProjectPageTop from '../../../components/projects/ProjectPageTop.astro';
import ProjectEndedNotice from '../../../components/projects/ProjectEndedNotice.astro';
import ProjectFactsBox from '../../../components/projects/ProjectFactsBox.astro';
import ProjectFunding from '../../../components/projects/ProjectFunding.astro';
import TableOfContents from '../../../components/layout/TableOfContents.astro';
import ProjectRows from '../../../components/projects/ProjectRows.astro';
import ProjectColumns from '../../../components/projects/ProjectColumns.astro';
import ProjectSection from '../../../components/projects/ProjectSection.astro';
import Icon from '../../../components/mdx/Icon.astro';
import { getEntry, render } from 'astro:content';
import { getInsert } from '../../../utils/content';
import { countLabel } from '../../../utils/projectFacts';
import { getProject, getProjectEvents, getProjectNews } from '../../../utils/projectPages';

const project = await getProject('esg', 'partners');
const { Content: Summary, headings: summaryHeadings } = await render(project.entry);
const fundingSlug = 'projects/esg/funding_notice';
const hasFunding = Boolean(await getInsert(fundingSlug));

// Load ESG data from datasets collection (content/projects/esg/*.yml, keyed by file name)
const objectives = (await getEntry('datasets', 'objectives'))?.data;
const expectedResults = (await getEntry('datasets', 'expected_results'))?.data;
const partners = (await getEntry('datasets', 'partners'))?.data;
const externalLinks = (await getEntry('datasets', 'external_links'))?.data;

const esgNews = await getProjectNews(project.source);
const latestNews = esgNews.slice(0, 6);
const pastEvents = (await getProjectEvents(project.source, { pastOnly: true })).slice(0, 5);

const newsHref = '/projects/esg/news/';
const eventsHref = '/projects/esg/events/';

function partnerLogo(image?: string): string {
  return image?.startsWith('/') ? image : `/images/projects/esg/partner-logos/${image?.split('/').pop()}`;
}

const headings = [
  ...summaryHeadings.filter((heading) => heading.depth === 2),
  objectives && { depth: 2, slug: 'objectives', text: objectives.heading || 'Objectives' },
  externalLinks && { depth: 2, slug: 'projects', text: externalLinks.heading || 'Projects Part of ESG' },
  { depth: 2, slug: 'work-packages', text: 'Work Packages' },
  expectedResults && { depth: 2, slug: 'results', text: expectedResults.heading || 'Expected Results' },
  { depth: 2, slug: 'news', text: 'News' },
  { depth: 2, slug: 'past-events', text: 'Past events' },
  partners && { depth: 2, slug: 'partners', text: 'Project Partners' },
  hasFunding && { depth: 2, slug: 'funding', text: 'Funding' },
].filter((heading): heading is { depth: number; slug: string; text: string } => Boolean(heading));
---

<BaseLayout title={project.name} description={project.description}>
  <div class="esg-page max-w-6xl mx-auto bg-white rounded-lg shadow-sm p-4 sm:p-6 lg:p-8">
    <ProjectPageTop
      projectId={project.id}
      name={project.name}
      description={project.description}
      facts={project.facts}
      counts={{ [newsHref]: esgNews.length }}
    />

    <ProjectColumns>
      <Fragment slot="lead">
        <ProjectEndedNotice
          name={project.name}
          facts={project.facts}
          record="This page keeps its objectives, results, partners and news as a record. Events are listed as past events."
        />
        <ProjectFactsBox
          class="lg:hidden mb-6"
          idPrefix="facts-inline"
          facts={project.facts}
          partnerCount={project.partnerCount}
        />
      </Fragment>

      <Fragment slot="rail">
        <ProjectFactsBox
          class="project-facts--rail mb-6"
          idPrefix="facts-rail"
          facts={project.facts}
          partnerCount={project.partnerCount}
        />
        <TableOfContents headings={headings} />
      </Fragment>

      <div class="prose prose-galaxy max-w-none">
        <Summary />
      </div>

      {objectives && <ProjectSection id="objectives" title={objectives.heading || 'Objectives'}>
        <ol class="esg-numlist">
          {objectives.objectives?.map((obj: any, index: number) => <li>
            <span class="esg-numlist__n" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{obj.title}</h3>
              <p>{obj.content}</p>
            </div>
          </li>)}
        </ol>
      </ProjectSection>}

      {externalLinks && <ProjectSection id="projects" title={externalLinks.heading || 'Projects Part of ESG'}>
        <ul class="esg-logolinks">
          {externalLinks.external_links?.map((link: any) => <li>
            <img
              src={`/images/projects/esg/link-images/${link.image?.split('/').pop()}`}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.name}
              <span aria-hidden="true"><Icon name="external-link" size={12} /></span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>)}
        </ul>
      </ProjectSection>}

      <section class="esg-poster">
        <EsgInteractivePoster />
      </section>

      {expectedResults && <ProjectSection id="results" title={expectedResults.heading || 'Expected Results'}>
        <ul class="esg-results">
          {expectedResults.expected_results?.map((result: any) => <li>
            <span class="esg-results__icon" aria-hidden="true"><Icon name="target" size={16} /></span>
            <h3>{result.title}</h3>
            <p>{result.content}</p>
          </li>)}
        </ul>
      </ProjectSection>}

      <ProjectSection
        id="news"
        title="News"
        more={{ href: newsHref, label: `All ${esgNews.length} news`, context: `from ${project.name}` }}
      >
        {latestNews.length > 0 ? (
          <ProjectRows
            kind="news"
            items={latestNews.map((item) => ({
              href: `/${item.data.slug}/`,
              title: item.data.title,
              tease: item.data.tease,
              start: item.data.date,
            }))}
          />
        ) : (
          <p class="text-chicago-700 text-sm">No news articles yet.</p>
        )}
      </ProjectSection>

      <ProjectSection
        id="past-events"
        title="Past events"
        more={{ href: eventsHref, label: 'All past events', context: `of ${project.name}` }}
      >
        {pastEvents.length > 0 ? (
          <ProjectRows
            kind="events"
            items={pastEvents.map((event) => ({
              href: `/${event.data.slug}/`,
              title: event.data.title,
              tease: event.data.tease,
              start: event.data.date,
              end: event.data.end,
            }))}
          />
        ) : (
          <p class="text-chicago-700 text-sm">No past events.</p>
        )}
      </ProjectSection>

      {partners && <ProjectSection
        id="partners"
        title="Project Partners"
        count={countLabel(project.partnerCount, 'organisation')}
      >
        <ul class="esg-partners">
          {partners.partners?.map((partner: any) => <li>
            <a href={partner.website} target="_blank" rel="noopener noreferrer">
              <span class="esg-partners__logo">
                <img src={partnerLogo(partner.image)} alt="" loading="lazy" decoding="async" />
              </span>
              <span> {partner.name}<span class="sr-only"> (opens in a new tab)</span> </span>
            </a>
          </li>)}
        </ul>
      </ProjectSection>}

      <ProjectFunding slug={fundingSlug} class="mt-10" />
    </ProjectColumns>
  </div>
</BaseLayout>

<style>
  .esg-poster {
    margin-top: 2.5rem;
  }

  .esg-numlist,
  .esg-logolinks,
  .esg-results,
  .esg-partners {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .esg-numlist {
    display: grid;
    gap: 12px;
  }

  .esg-numlist li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .esg-numlist__n {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-galaxy-primary);
  }

  .esg-numlist h3,
  .esg-results h3 {
    margin: 0 0 2px;
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--color-galaxy-dark);
  }

  .esg-numlist p,
  .esg-results p {
    margin: 0;
    color: var(--color-chicago-900);
  }

  .esg-logolinks {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }

  .esg-logolinks li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--color-chicago-100);
    border-radius: 0.5rem;
    text-align: center;
  }

  .esg-logolinks img {
    width: auto;
    max-width: 140px;
    height: 48px;
    padding: 4px 6px;
    border-radius: 0.25rem;
    object-fit: contain;
    background: #f3f4f6;
    box-sizing: content-box;
  }

  .esg-logolinks a {
    color: var(--color-galaxy-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: 24px;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .esg-logolinks a:hover {
    text-decoration-color: var(--color-galaxy-gold);
  }

  .esg-results {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
  }

  .esg-results li {
    padding: 14px 16px;
    border: 1px solid var(--color-chicago-100);
    border-radius: 0.5rem;
  }

  .esg-results p {
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .esg-results__icon {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 6px;
    border-radius: 0.25rem;
    color: var(--color-galaxy-primary);
    background: var(--color-light-bg);
  }

  .esg-partners {
    display: grid;
    gap: 10px;
    margin-top: 16px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }

  .esg-partners a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding: 14px 10px 12px;
    border: 1px solid var(--color-chicago-100);
    border-radius: 0.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-galaxy-dark);
    text-decoration: none;
  }

  .esg-partners a:hover {
    border-color: var(--color-chicago-300);
    color: var(--color-galaxy-primary);
    text-decoration: underline;
  }

  .esg-partners__logo {
    display: grid;
    place-items: center;
    align-self: stretch;
    height: 52px;
    padding: 4px 8px;
    border-radius: 0.25rem;
    background: #f3f4f6;
  }

  .esg-partners__logo img {
    width: auto;
    max-width: 120px;
    max-height: 44px;
    object-fit: contain;
  }
</style>
