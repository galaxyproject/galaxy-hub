---
/**
 * Events page of a project section (/projects/<id>/events/): events from the project's feed, newest
 * first. A project that has ended lists only its past events. One route serves every project in
 * siteContext.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectPageTop from '../../../components/projects/ProjectPageTop.astro';
import ProjectRows from '../../../components/projects/ProjectRows.astro';
import ProjectFunding from '../../../components/projects/ProjectFunding.astro';
import { getInsert } from '../../../utils/content';
import { isPastEvent } from '../../../utils/dateUtils';
import { countLabel, projectStatus } from '../../../utils/projectFacts';
import { getProject, getProjectEvents, getProjectNews } from '../../../utils/projectPages';
import { projectContextIds } from '../../../utils/siteContext';

export function getStaticPaths() {
  return projectContextIds().map((id) => ({ params: { project: id }, props: { id } }));
}

const { id } = Astro.props as { id: string };
const now = new Date();
const project = await getProject(id);
const ended = projectStatus(project.facts, now) === 'ended';
const intro = (await getInsert(`projects/${id}/events`))?.data as { description?: string } | undefined;
const newsCount = (await getProjectNews(project.source)).length;
const events = await getProjectEvents(project.source, { pastOnly: ended, now });

const label = ended ? 'Past events' : 'Events';
const headingId = ended ? 'past-events-title' : 'events-title';
const pageTitle = `${project.name} ${ended ? 'past events' : 'Events'}`;
const description = intro?.description ?? `${label} of ${project.name}`;
const count = countLabel(events.length, ended ? 'past event' : 'event');
---

<BaseLayout title={`${label} | ${project.name}`} description={description}>
  <div class="max-w-6xl mx-auto bg-white rounded-lg shadow-sm p-4 sm:p-6 lg:p-8">
    <ProjectPageTop
      projectId={project.id}
      name={project.name}
      description={project.description}
      facts={project.facts}
      counts={{ [`/projects/${id}/news/`]: newsCount }}
      title={pageTitle}
      lead={intro?.description}
    />

    <section aria-labelledby={headingId} class="max-w-4xl">
      <h2 id={headingId} class="sr-only">{label}</h2>
      <p class="text-sm text-chicago-700 mb-2">{count}, newest first</p>
      {events.length > 0 ? (
        <ProjectRows
          kind="events"
          items={events.map((event) => ({
            href: `/${event.data.slug}/`,
            title: event.data.title,
            tease: event.data.tease,
            start: event.data.date,
            end: event.data.end,
            past: ended ? undefined : isPastEvent(event.data.date, event.data.end, now),
          }))}
        />
      ) : (
        <p class="text-chicago-700 text-sm">{ended ? 'No past events.' : 'No events yet.'}</p>
      )}
    </section>

    <ProjectFunding slug={`projects/${id}/funding_notice`} class="mt-10" />
  </div>
</BaseLayout>
