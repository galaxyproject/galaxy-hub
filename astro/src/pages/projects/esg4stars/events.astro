---
/**
 * ESG4Stars events: upcoming and past events tagged esg4stars, newest first.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectPageTop from '../../../components/projects/ProjectPageTop.astro';
import ProjectRows from '../../../components/projects/ProjectRows.astro';
import ProjectFunding from '../../../components/projects/ProjectFunding.astro';
import { getInsert } from '../../../utils/content';
import { isPastEvent } from '../../../utils/dateUtils';
import { countLabel } from '../../../utils/projectFacts';
import { getProject, getProjectEvents, getProjectNews } from '../../../utils/projectPages';

const project = await getProject('esg4stars');
const intro = (await getInsert('projects/esg4stars/events'))?.data as { description?: string } | undefined;
const newsCount = (await getProjectNews(project.source)).length;
const events = await getProjectEvents(project.source);
const now = new Date();
---

<BaseLayout title={`Events | ${project.name}`} description={intro?.description ?? `Events of ${project.name}`}>
  <div class="max-w-6xl mx-auto bg-white rounded-lg shadow-sm p-4 sm:p-6 lg:p-8">
    <ProjectPageTop
      projectId={project.id}
      name={project.name}
      description={project.description}
      facts={project.facts}
      counts={{ '/projects/esg4stars/news/': newsCount }}
      title={`${project.name} Events`}
      lead={intro?.description}
    />

    <section aria-labelledby="events-title" class="max-w-4xl">
      <h2 id="events-title" class="sr-only">Events</h2>
      <p class="text-sm text-chicago-700 mb-2">{countLabel(events.length, 'event')}, newest first</p>
      {events.length > 0 ? (
        <ProjectRows
          kind="events"
          items={events.map((event) => ({
            href: `/${event.data.slug}/`,
            title: event.data.title,
            tease: event.data.tease,
            start: event.data.date,
            end: event.data.end,
            past: isPastEvent(event.data.date, event.data.end, now),
          }))}
        />
      ) : (
        <p class="text-chicago-700 text-sm">No events yet.</p>
      )}
    </section>

    <ProjectFunding slug="projects/esg4stars/funding_notice" class="mt-10" />
  </div>
</BaseLayout>
