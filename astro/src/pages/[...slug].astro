---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { isDraft } from '../utils/publish-date.mjs';
import { articleCrumbs } from '../utils/breadcrumbs';

// Import MDX components for embedded content
import VegaEmbed from '../components/mdx/VegaEmbed.astro';
import Mastodon from '../components/mdx/Mastodon.astro';
import VideoPlayer from '../components/mdx/VideoPlayer.astro';
import Carousel from '../components/mdx/Carousel.astro';
import CalendarEmbed from '../components/mdx/CalendarEmbed.astro';
import MarkdownEmbed from '../components/mdx/MarkdownEmbed.astro';
import Flickr from '../components/mdx/Flickr.astro';
import Supporters from '../components/mdx/Supporters.astro';
import Contacts from '../components/mdx/Contacts.astro';
import Icon from '../components/mdx/Icon.astro';
import CopyButton from '../components/mdx/CopyButton.astro';
import Insert from '../components/mdx/Insert.astro';
import AgentShells from '../components/mdx/AgentShells.astro';
import HarnessGuides from '../components/mdx/HarnessGuides.astro';
import HarnessGuide from '../components/mdx/HarnessGuide.astro';
import AgenticStack from '../components/mdx/AgenticStack.astro';
import AgentsLanding from '../components/mdx/AgentsLanding.astro';
import OrbitHero from '../components/mdx/OrbitHero.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  // Filter out events/ and use/ articles (they have their own routes)
  // News is in its own collection so no need to filter it here
  const genericArticles = articles.filter((article) => {
    const slug = article.data.slug;
    return !slug.startsWith('events/') && !slug.startsWith('use/');
  });

  // Titles of every content page by URL, for the parent levels of each page's breadcrumbs
  const pageTitles = new Map<string, string>();
  for (const { data } of articles) {
    if (data.title) pageTitles.set(`/${data.slug}/`, data.title);
  }

  return genericArticles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, pageTitles },
  }));
}

const { article, pageTitles } = Astro.props;
const { Content, headings } = await render(article);
const sourceFile = article.data.sourceFile || `${article.data.slug}/index.md`;
const fairSection =
  article.data.slug === 'fair' || article.data.slug.startsWith('fair/') ? article.data.slug : undefined;

const { title, date, tags = [], tease, image, autotoc } = article.data;
const crumbs = articleCrumbs(article.data.slug, title || 'Galaxy Hub', pageTitles);

// MDX components map - keys match PascalCase names used in preprocessed content
const components = {
  VegaEmbed,
  Mastodon,
  VideoPlayer,
  Carousel,
  CalendarEmbed,
  MarkdownEmbed,
  Flickr,
  Supporters,
  Contacts,
  Icon,
  CopyButton,
  Insert,
  AgentShells,
  HarnessGuides,
  HarnessGuide,
  AgenticStack,
  AgentsLanding,
  OrbitHero,
};
---

<ArticleLayout
  noindex={isDraft(article.data)}
  title={title || 'Galaxy Hub'}
  description={tease}
  date={date}
  tags={tags}
  image={image}
  crumbs={crumbs}
  headings={headings}
  autotoc={autotoc}
  sourceFile={sourceFile}
  fairSection={fairSection}
  hideHeader={article.data.skip_title_render === true}
  fullBleed={article.data.full_bleed === true}
  generatedFrom={article.data.generated_from ?? undefined}
  ogImage={article.data.og_image ?? undefined}
>
  <Content components={components} />
</ArticleLayout>
