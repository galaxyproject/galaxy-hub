---
/**
 * MobileToc - the collapsible "On this page" block shown where the sticky rail is not.
 *
 * The caller sets placement and the breakpoint that hides it (class), so each layout keeps
 * its own spacing. The summary names the block, so the list has no inner title.
 */
import TableOfContents from './TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  class?: string;
}

const { headings, class: className = '' } = Astro.props;
const summaryClass = 'px-4 py-3 cursor-pointer font-medium text-galaxy-primary hover:bg-ebony-clay-50 rounded-lg';
---

<details class={className}>
  <summary class={summaryClass}>On this page</summary>
  <div class="px-4 pb-4">
    <TableOfContents headings={headings} showTitle={false} />
  </div>
</details>
