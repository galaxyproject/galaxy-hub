---
// Sidebar navigation for Galaxy Hub
// Desktop: Fixed left sidebar with Vue-powered navigation
// Mobile: Hidden (use MobileMenu.vue for mobile)
import SidebarNav from './SidebarNav.vue';
import type { NavbarData } from '@/utils/navbar';
import type { SubsiteId } from '@/stores/subsiteStore';
import Icon from '../mdx/Icon.astro';

interface Props {
  navbar?: NavbarData | null;
  initialSubsite?: SubsiteId;
}

const { navbar, initialSubsite } = Astro.props as Props;
---

<aside
  class="site-sidebar hidden lg:flex flex-col w-64 bg-galaxy-dark text-white fixed left-0 top-0 h-screen overflow-y-auto z-40"
>
  <!-- Logo Section -->
  <div class="p-4 pr-6 border-b border-medium-bg flex justify-center">
    <a href="/" class="sidebar-logo block">
      <img src="/images/galaxy_logo_hub_white.svg" alt="Galaxy Community Hub" class="h-10 w-auto" />
    </a>
  </div>

  <!-- Search -->
  <div class="p-4 border-b border-medium-bg">
    <form action="/search/" method="get">
      <div class="relative">
        <input
          type="search"
          name="q"
          placeholder="Search..."
          class="w-full bg-medium-bg text-white placeholder-chicago-400 rounded-md py-2 px-3 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-galaxy-gold"
        />
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-chicago-400 hover:text-galaxy-gold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- Navigation (Vue component for collapsible sections) -->
  <div class="flex-1 p-4 overflow-y-auto">
    <SidebarNav client:load navbar={navbar} initialSubsite={initialSubsite} />
  </div>

  <!-- Archive notice -->
  <div id="archive-notice" class="mx-3 mb-3 p-3 rounded-md bg-medium-bg text-xs text-chicago-300 leading-relaxed">
    <div class="flex items-start justify-between gap-2">
      <p class="m-0">
        Missing something?<br />
        <a
          id="archive-link"
          href="https://archive.galaxyproject.org"
          target="_blank"
          rel="noopener noreferrer"
          class="text-galaxy-gold hover:underline">View this page on the old site</a
        >
      </p>
      <button
        id="archive-dismiss"
        class="shrink-0 text-chicago-500 hover:text-chicago-300 transition-colors"
        aria-label="Dismiss"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Social links -->
  <div class="p-4 border-t border-medium-bg">
    <div class="flex justify-center gap-4">
      <a
        href="https://github.com/galaxyproject"
        class="social-icon text-chicago-400 hover:text-galaxy-gold"
        aria-label="GitHub"
        target="_blank"
        rel="noopener"
      >
        <Icon name="github" size={20} />
      </a>
      <a
        href="https://www.youtube.com/@galaxyproject"
        class="social-icon text-chicago-400 hover:text-galaxy-gold"
        aria-label="YouTube"
        target="_blank"
        rel="noopener"
      >
        <Icon name="youtube" size={20} />
      </a>
      <a
        href="https://mstdn.science/@galaxyproject"
        class="social-icon text-chicago-400 hover:text-galaxy-gold"
        aria-label="Mastodon"
        target="_blank"
        rel="noopener"
      >
        <Icon name="mastodon" size={20} />
      </a>
      <a
        href="https://www.linkedin.com/company/galaxy-project"
        class="social-icon text-chicago-400 hover:text-galaxy-gold"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener"
      >
        <Icon name="linkedin" size={20} />
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar-logo {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .sidebar-logo:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.4));
  }

  /* Social icon hover animations */
  .social-icon {
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .social-icon:hover {
    transform: scale(1.15);
  }
</style>

<script>
  function initArchiveNotice() {
    const notice = document.getElementById('archive-notice');
    const link = document.getElementById('archive-link') as HTMLAnchorElement | null;
    const dismiss = document.getElementById('archive-dismiss');

    if (!notice) return;

    if (localStorage.getItem('archive-notice-dismissed')) {
      notice.remove();
      return;
    }

    if (link) {
      link.href = `https://archive.galaxyproject.org${window.location.pathname}`;
    }

    dismiss?.addEventListener('click', () => {
      notice.remove();
      localStorage.setItem('archive-notice-dismissed', '1');
    });
  }

  document.addEventListener('astro:page-load', initArchiveNotice);
</script>
