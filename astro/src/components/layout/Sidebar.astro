---
// Sidebar navigation for Galaxy Hub
// Desktop: Fixed left sidebar with Vue-powered navigation
// Mobile: Hidden (use MobileMenu.vue for mobile)
import SidebarNav from './SidebarNav.vue';
import ContextSwitcher from './ContextSwitcher.vue';
import type { NavbarData } from '@/utils/navbar';
import type { SubsiteId } from '@/stores/subsiteStore';
import Icon from '../mdx/Icon.astro';

interface Props {
  navbar?: NavbarData | null;
  initialSubsite?: SubsiteId;
  /** transition:persist name; the sidebar survives view transitions between pages with the same name. */
  persistKey?: string;
}

const { navbar, initialSubsite, persistKey } = Astro.props as Props;
---

<aside
  class="site-sidebar hidden lg:flex flex-col w-64 bg-galaxy-dark text-white fixed left-0 top-0 h-screen z-40"
  transition:persist={persistKey}
>
  <!-- Pinned top: logo, context header, search (never scrolls) -->
  <div class="relative z-10 flex flex-none flex-col gap-2.5 border-b border-white/[0.08] p-3">
    <div class="flex min-h-11 items-center px-1">
      <a href="/" class="sidebar-logo block">
        <img src="/images/galaxy_logo_hub_white.svg" alt="Galaxy Community Hub" class="h-[33px] w-auto" />
      </a>
    </div>

    <ContextSwitcher client:load currentPath={Astro.url.pathname} idPrefix="sb" />

    <!-- Search -->
    <form action="/search/" method="get">
      <div class="relative">
        <input
          type="search"
          name="q"
          placeholder="Search..."
          aria-keyshortcuts="Meta+K Control+K"
          data-search-shortcut="sidebar"
          class="peer w-full bg-medium-bg text-white placeholder-chicago-200 rounded-md py-2 px-3 pr-20 text-sm focus:outline-none focus:ring-2 focus:ring-galaxy-gold"
        />
        <kbd
          data-search-shortcut-hint
          aria-hidden="true"
          hidden
          class="pointer-events-none absolute right-9 top-1/2 -translate-y-1/2 rounded border border-chicago-500 bg-galaxy-dark px-1.5 py-0.5 font-sans text-xs leading-none text-chicago-200 peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden"
        ></kbd>
        <button
          type="submit"
          class="absolute right-2 top-1/2 -translate-y-1/2 text-chicago-200 hover:text-galaxy-gold"
          aria-label="Search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            ></path>
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- Scrollable area: grouped navigation, archive notice, social links -->
  <div
    class="sidebar-scroll flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-3 pb-5 pt-3.5"
    data-sidebar-scroll
  >
    <SidebarNav client:load navbar={navbar} initialSubsite={initialSubsite} currentPath={Astro.url.pathname} />

    <!-- Archive notice -->
    <div id="archive-notice" class="mt-5 p-3 rounded-md bg-medium-bg text-xs text-chicago-200 leading-relaxed">
      <div class="flex items-start justify-between gap-2">
        <p class="m-0">
          Missing something?<br />
          <a
            id="archive-link"
            href="https://archive.galaxyproject.org"
            target="_blank"
            rel="noopener noreferrer"
            class="text-galaxy-gold hover:underline"
            >View this page on the old site</a
          >
        </p>
        <button
          id="archive-dismiss"
          class="shrink-0 text-chicago-500 hover:text-chicago-300 transition-colors"
          aria-label="Dismiss"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Social links -->
    <div class="mt-3 pt-4 border-t border-white/[0.08]">
      <div class="flex justify-center gap-4">
        <a
          href="https://github.com/galaxyproject"
          class="social-icon text-chicago-400 hover:text-galaxy-gold"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
        >
          <Icon name="github" size={20} />
        </a>
        <a
          href="https://www.youtube.com/@galaxyproject"
          class="social-icon text-chicago-400 hover:text-galaxy-gold"
          aria-label="YouTube"
          target="_blank"
          rel="noopener"
        >
          <Icon name="youtube" size={20} />
        </a>
        <a
          href="https://mstdn.science/@galaxyproject"
          class="social-icon text-chicago-400 hover:text-galaxy-gold"
          aria-label="Mastodon"
          target="_blank"
          rel="noopener"
        >
          <Icon name="mastodon" size={20} />
        </a>
        <a
          href="https://www.linkedin.com/company/galaxy-project"
          class="social-icon text-chicago-400 hover:text-galaxy-gold"
          aria-label="LinkedIn"
          target="_blank"
          rel="noopener"
        >
          <Icon name="linkedin" size={20} />
        </a>
      </div>
    </div>
  </div>
</aside>

<style>
  .sidebar-logo {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .sidebar-logo:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.4));
  }

  /* Social icon hover animations */
  .social-icon {
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .social-icon:hover {
    transform: scale(1.15);
  }

  .sidebar-scroll {
    scrollbar-width: thin;
    scrollbar-color: #4c5574 transparent; /* ebony-clay-700 */
  }
</style>

<script>
  function initArchiveNotice() {
    const notice = document.getElementById('archive-notice');
    const link = document.getElementById('archive-link') as HTMLAnchorElement | null;
    const dismiss = document.getElementById('archive-dismiss');

    if (!notice) return;

    if (localStorage.getItem('archive-notice-dismissed')) {
      notice.remove();
      return;
    }

    if (link) {
      link.href = `https://archive.galaxyproject.org${window.location.pathname}`;
    }

    dismiss?.addEventListener('click', () => {
      notice.remove();
      localStorage.setItem('archive-notice-dismissed', '1');
    });
  }

  document.addEventListener('astro:page-load', initArchiveNotice);
</script>
