---
/**
 * ContentWithToc - Wraps article content with optional Table of Contents
 *
 * Handles both mobile (collapsible) and desktop (sidebar) TOC display.
 * Use this component to avoid duplicating TOC logic across page templates.
 */
import TableOfContents from './TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  autotoc?: boolean;
  /** Cap running text at the 72ch measure (off for full-bleed pages). */
  measure?: boolean;
}

const { headings = [], autotoc = false, measure = true } = Astro.props;

// Determine if TOC should be shown (autotoc enabled and enough headings)
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const showToc = autotoc && filteredHeadings.length >= 2;

// Reading grid (DESIGN.md §5): from xl (1280px) a 72ch text column and a 224px sticky rail
// pushed to the right edge; below xl one column with the collapsible block on top.
// xl:px-4 makes the grid as wide as prototype A's page frame (main inset 24px + 16px = its
// 40px), so space-between leaves the same text-to-rail gap.
const gridClass = 'xl:grid xl:grid-cols-[minmax(0,var(--measure))_14rem] xl:justify-between xl:gap-x-12 xl:px-4';
const mobileTocClass = 'toc-mobile xl:hidden mx-6 sm:mx-8 mt-6 border border-ebony-clay-100 rounded-lg';
const summaryClass = 'px-4 py-3 cursor-pointer font-medium text-galaxy-primary hover:bg-ebony-clay-50 rounded-lg';
const railClass = 'sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto pt-0.5 pr-1 pb-4 pl-0.5';
// Without a rail the 72ch text blocks are centred, so no empty strip opens on the right;
// tile grids, tables and figures keep the full column.
const proseClass = [
  'prose prose-compact prose-galaxy max-w-none min-w-0',
  measure && 'prose-measure',
  measure && !showToc && 'prose-measure-centred',
];
---

{/* Below xl: collapsible block above the text (its summary names it, so no inner title) */}
{showToc && <details class={mobileTocClass}>
  <summary class={summaryClass}>On this page</summary>
  <div class="px-4 pb-4">
    <TableOfContents headings={headings} showTitle={false} />
  </div>
</details>}

<div class:list={['content-with-toc px-6 sm:px-8 pt-6', showToc && gridClass]}>
  {/* Main Content */}
  <div class:list={proseClass}>
    <slot />
  </div>

  {/* From xl: the sticky "On this page" rail; it scrolls itself when taller than the window */}
  {showToc && <div class="toc-sidebar hidden xl:block">
    <div class={railClass} data-toc-rail>
      <TableOfContents headings={headings} backToTop />
    </div>
  </div>}
</div>
