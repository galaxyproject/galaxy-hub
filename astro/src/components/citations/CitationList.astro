---
import { groupCitationsByYear, type Citation } from '../../utils/citations';

interface Props {
  citations: Citation[];
  noun?: { singular: string; plural: string };
}

const { citations, noun = { singular: 'citation', plural: 'citations' } } = Astro.props;
const { yearCounts, years } = groupCitationsByYear(citations);
---

<div class="space-y-6">
  <section class="rounded-lg border border-galaxy-primary/10 bg-bay-of-many-50 p-4 space-y-3">
    <p class="text-sm text-chicago-700 font-medium">Filter by year</p>
    <div class="flex flex-wrap items-center gap-2">
      <a
        data-year-button
        data-year="all"
        href="."
        class="px-3 py-1.5 text-sm font-medium rounded-md bg-galaxy-primary text-white"
        aria-pressed="true"
      >
        All <span class="ml-1 text-xs opacity-80">({citations.length})</span>
      </a>
      {years.map((year) => <a
        data-year-button
        data-year={year}
        href={`?year=${encodeURIComponent(year)}`}
        class="px-3 py-1.5 text-sm font-medium rounded-md bg-ebony-clay-50 text-chicago-700 hover:bg-ebony-clay-100"
        aria-pressed="false"
      >
        {year === 'unknown' ? 'Unknown year' : year}
        <span class="ml-1 text-xs opacity-80">({yearCounts[year]})</span>
      </a>)}
    </div>
    <p class="text-sm text-chicago-500" data-filter-count data-noun={noun.plural}>
      Showing {citations.length}
      {citations.length === 1 ? noun.singular : noun.plural}
    </p>
  </section>

  {citations.map((c, idx) => <article
    class="rounded-lg border border-galaxy-primary/10 bg-white p-4 shadow-sm"
    key={`${c.title || 'citation'}-${idx}`}
    data-citation-year={c.year ? String(c.year) : 'unknown'}
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-galaxy-dark">
          {c.url ? (
            <a
              href={c.url}
              class="hover:text-galaxy-primary transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              set:html={c.title || 'Untitled'}
            />
          ) : (
            <span set:html={c.title || 'Untitled'} />
          )}
        </h2>
        {c.authors && <p class="text-sm text-chicago-600 mt-1">{c.authors}</p>}
      </div>
    </div>
  </article>)}
</div>

<script>
  import { onPopState, readParams, writeParams } from '@/utils/urlFilters';

  const FILTER_PARAMS = { year: 'all' };

  // The ClientRouter runs this module once, so set up again on every page load
  function init() {
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-year-button]'));
    // Not a citations page: leave its URL alone
    if (buttons.length === 0) return;
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-citation-year]'));
    const countEl = document.querySelector<HTMLElement>('[data-filter-count]');
    const noun = countEl?.dataset.noun || 'citations';

    function applyFilter(year) {
      let visible = 0;

      items.forEach((item) => {
        const itemYear = item.dataset.citationYear || 'unknown';
        const matches = year === 'all' ? true : itemYear === year;
        item.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });

      buttons.forEach((btn) => {
        const isActive = (btn.dataset.year || 'all') === year;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        btn.classList.toggle('bg-galaxy-primary', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('bg-ebony-clay-50', !isActive);
        btn.classList.toggle('text-chicago-700', !isActive);
      });

      if (countEl) {
        const label = year === 'all' ? noun : `${noun} for ${year === 'unknown' ? 'Unknown year' : year}`;
        countEl.textContent = `Showing ${visible} ${label}`;
      }

      writeParams({ year }, { defaults: FILTER_PARAMS });
    }

    function yearFromUrl() {
      const fromQuery = readParams(FILTER_PARAMS).year ?? 'all';
      const normalized = fromQuery.toLowerCase() === 'unknown' ? 'unknown' : fromQuery;
      return buttons.some((b) => (b.dataset.year || '') === normalized) ? normalized : 'all';
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        applyFilter(btn.dataset.year || 'all');
      });
    });

    // Back/forward restores the year from the URL; stop listening once the router swaps the page
    const stopPopState = onPopState(() => applyFilter(yearFromUrl()));
    document.addEventListener('astro:before-swap', stopPopState, { once: true });

    applyFilter(yearFromUrl());
  }

  document.addEventListener('astro:page-load', init);
</script>
