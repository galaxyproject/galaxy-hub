---
import type { Citation } from '../../utils/citations';
import { countByYear } from '../../utils/listFilters';
import CitationFilters from './CitationFilters.vue';

interface Props {
  citations: Citation[];
  noun?: { singular: string; plural: string };
}

const { citations, noun = { singular: 'citation', plural: 'citations' } } = Astro.props;
// The list is server HTML; the island only gets the year counts and filters the articles in place
const years = countByYear(citations, (c) => c.year);
const unknownCount = citations.filter((c) => !c.year).length;
---

<div class="citation-list" data-citation-list>
  <CitationFilters
    client:load
    path={Astro.url.pathname}
    total={citations.length}
    years={years}
    unknownCount={unknownCount > 0 ? unknownCount : undefined}
    noun={noun}
  />

  <div class="space-y-6">
    {citations.map((c) => <article
      class="rounded-lg border border-galaxy-primary/10 bg-white p-4 shadow-sm"
      data-citation-year={c.year ? String(c.year) : 'unknown'}
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-galaxy-dark">
            {c.url ? (
              <a
                href={c.url}
                class="hover:text-galaxy-primary transition-colors"
                target="_blank"
                rel="noopener noreferrer"
                set:html={c.title || 'Untitled'}
              />
            ) : (
              <span set:html={c.title || 'Untitled'} />
            )}
          </h2>
          {c.authors && <p class="text-sm text-chicago-600 mt-1">{c.authors}</p>}
        </div>
      </div>
    </article>)}
  </div>

  <p class="hidden py-12 text-center text-chicago-500" data-citation-empty>No {noun.plural} found.</p>
</div>
