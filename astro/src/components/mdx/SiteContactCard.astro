---
import Icon from './Icon.astro';

export interface ContactLink {
  href: string;
  icon: string;
  label: string;
  rel?: string;
  target?: string;
}

interface Props {
  links: ContactLink[];
  /** Rendered Markdown in the slot: its plain links get the DESIGN.md §3 text-link style and its blocks are spaced. */
  prose?: boolean;
}

const { links, prose = false } = Astro.props;

// Plain links in rendered Markdown match the textLink class in linkClasses.ts; chips are styled separately.
const proseClasses = [
  'text-chicago-700 [&>*+*]:mt-4',
  '[&_a]:text-galaxy-primary [&_a]:underline [&_a]:underline-offset-2',
  '[&_a:hover]:text-link-hover [&_a:hover]:decoration-link-hover-line [&_a:hover]:decoration-2',
].join(' ');
---

<section class="mt-12 rounded-lg border border-galaxy-primary/10 bg-white p-6 text-center shadow-sm">
  {prose ? <div class={proseClasses}><slot /></div> : <slot />}

  {links.length > 0 && <ul class="mt-5 flex flex-wrap items-center justify-center gap-3 text-sm">
    {links.map((link) => <li>
      <a
        class="inline-flex items-center gap-1.5 rounded-md border border-galaxy-primary/15 px-3 py-1.5 text-galaxy-primary hover:border-galaxy-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-galaxy-primary"
        href={link.href}
        target={link.target}
        rel={link.rel}
      >
        <Icon name={link.icon} size={16} />
        {link.label}
      </a>
    </li>)}
  </ul>}
</section>
