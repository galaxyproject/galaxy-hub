---
/**
 * AgentsLanding: the /agents/ front door. A dark hero that routes people to
 * Orbit (no agent yet) or to the plugin guides (bringing their own agent),
 * then a row of pointers into the rest of the section. The page's own markdown
 * renders below, as this component's children.
 */
import { icons, svg } from '../../lib/icons';

const more = [
  {
    href: '/agents/stack/',
    title: 'The Galaxy agentic stack',
    body: 'Watch an agent write its own tool when nothing installed fits, and see everything Galaxy records.',
  },
  {
    href: '/tools/user-defined-tools/',
    title: 'User-defined tools',
    body: 'The small YAML tools an agent writes and runs in your account. Beta, enabled per account.',
  },
  {
    href: 'https://github.com/galaxyproject/galaxy-mcp',
    title: 'Galaxy MCP server',
    body: 'The connection underneath both paths, for building Galaxy into your own agent or app.',
    external: true,
  },
];
---

<div class="agl not-prose">
  <section class="agl-hero">
    <div class="agl-hero__inner">
      <p class="agl-eyebrow">AI agents on Galaxy</p>
      <h1 class="agl-title">Put an <em>AI agent</em> to work on Galaxy</h1>
      <p class="agl-lede">
        An agent can talk through your data, draft an analysis plan, run it on Galaxy and keep a record you can come
        back to. Pick how you want to start.
      </p>

      <div class="agl-paths">
        <div class="agl-path agl-path--orbit">
          <p class="agl-path__kicker">Just getting started?</p>
          <h2 class="agl-path__title">Use Orbit</h2>
          <p class="agl-path__body">
            A desktop app with the Galaxy connection and curated Galaxy skills already built in. Describe the analysis
            you want; it drafts a plan, waits for your approval, and runs it on Galaxy.
          </p>
          <p class="agl-path__meta">macOS, Linux and Windows. Beta; bring your own model key.</p>
          <div class="agl-path__actions">
            <a class="agl-action agl-action--dark" href="/agents/orbit/"
              >Install Orbit <Fragment set:html={svg(icons.arrow)} /></a
            >
            <a class="agl-action agl-action--quiet" href="https://galaxyproject.github.io/loom/">How it works</a>
          </div>
        </div>

        <div class="agl-path">
          <p class="agl-path__kicker">Already use a coding agent?</p>
          <h2 class="agl-path__title">Add Galaxy to it</h2>
          <p class="agl-path__body">
            Keep the harness you know. One install gives Claude Code, Codex, Antigravity or Pi the Galaxy connection and
            curated skills; Claude Desktop gets the connection.
          </p>
          <p class="agl-path__meta">Step-by-step setup for each harness, plus your Galaxy API key.</p>
          <div class="agl-path__actions">
            <a class="agl-action agl-action--gold" href="/agents/plugins/"
              >Set up your agent <Fragment set:html={svg(icons.arrow)} /></a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="agl-more" aria-label="More in this section">
    <ul class="agl-more__list">
      {
        more.map((m) => (
          <li>
            <a class="agl-tile" href={m.href} {...(m.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="agl-tile__title">
                {m.title} <Fragment set:html={svg(icons.arrow)} />
              </span>
              <span class="agl-tile__body">{m.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<div class="agl-prose">
  <slot />
</div>

<style>
  .agl {
    --agl-dark: var(--color-galaxy-dark, #2c3143);
    --agl-gold: var(--color-galaxy-gold, #ffd700);
    --agl-gold-dark: var(--color-galaxy-gold-dark, #d19e00);
    --agl-primary: var(--color-galaxy-primary, #25537b);
    /* Cancel the article padding so the hero runs edge to edge, as on the other agent pages. */
    margin: -1.5rem -1.5rem 0;
  }

  @media (min-width: 640px) {
    .agl {
      margin: -1.5rem -2rem 0;
    }
  }

  /* The hub's unlayered .prose rules outrank component classes; reset them here. */
  .agl :is(h1, h2, p) {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .agl a,
  .agl a:hover {
    text-decoration: none;
  }

  .agl-hero {
    background:
      radial-gradient(120% 90% at 85% -10%, color-mix(in srgb, var(--agl-primary) 55%, transparent), transparent 60%),
      linear-gradient(170deg, var(--agl-dark) 0%, #1e2231 100%);
    color: #fff;
  }

  .agl-hero__inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 3.25rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .agl-hero__inner {
      padding: 4rem 2.5rem 4.25rem;
    }
  }

  .agl-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--agl-gold);
  }

  .agl .agl-title {
    margin: 0.9rem 0 1rem;
    font-size: clamp(2rem, 5.2vw, 3.2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }

  .agl-title em {
    font-style: normal;
    color: var(--agl-gold);
  }

  .agl .agl-lede {
    max-width: 42rem;
    margin: 0 auto 2.25rem;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    text-wrap: pretty;
  }

  .agl-paths {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 52rem;
    margin: 0 auto;
    text-align: left;
  }

  @media (min-width: 720px) {
    .agl-paths {
      grid-template-columns: 1fr 1fr;
    }
  }

  .agl-path {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.5rem 1.5rem 1.4rem;
    border: 2px solid rgba(255, 255, 255, 0.22);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
  }

  .agl-path--orbit {
    border-color: var(--agl-gold);
    background: var(--agl-gold);
    color: var(--agl-dark);
  }

  .agl-path__kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .agl .agl-path__title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
  }

  .agl-path__body {
    font-size: 0.97rem;
    line-height: 1.5;
    opacity: 0.9;
  }

  .agl-path__meta {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .agl-path__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .agl-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .agl-action :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .agl a.agl-action--dark {
    padding: 0.65rem 1.2rem;
    background: var(--agl-dark);
    color: #fff;
  }

  .agl a.agl-action--dark:hover {
    background: #1e2231;
  }

  .agl a.agl-action--gold {
    padding: 0.65rem 1.2rem;
    background: var(--agl-gold);
    color: var(--agl-dark);
  }

  .agl a.agl-action--gold:hover {
    background: var(--agl-gold-dark);
  }

  .agl a.agl-action--quiet {
    color: var(--agl-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .agl-action:focus-visible,
  .agl-tile:focus-visible {
    outline: 2px solid var(--agl-primary);
    outline-offset: 2px;
  }

  .agl-more {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 0.5rem;
  }

  .agl-more__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .agl-more__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .agl-tile {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--agl-primary) 18%, transparent);
    border-radius: 0.6rem;
    background: #fff;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .agl-tile:hover {
    border-color: color-mix(in srgb, var(--agl-primary) 45%, transparent);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.06);
  }

  .agl-tile__title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--agl-primary);
  }

  .agl-tile__title :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .agl-tile__body {
    font-size: 0.92rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .agl-prose {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  @media print {
    .agl-hero {
      background: none;
      color: #000;
    }
    .agl-title,
    .agl-title em,
    .agl-lede,
    .agl-eyebrow,
    .agl-path,
    .agl a.agl-action--dark,
    .agl a.agl-action--gold {
      color: #000;
      background: none;
    }
  }
</style>
