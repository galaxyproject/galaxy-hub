---
/**
 * AgentsLanding: the /agents/ front door. Orbit is the default answer (one
 * large card with the real app), and bringing your own coding agent is the
 * secondary path, followed by pointers into the rest of the section. The
 * page's own markdown renders below, as this component's children.
 */
import { icons, svg } from '../../lib/icons';

const more = [
  {
    href: '/agents/stack/',
    title: 'The Galaxy agentic stack',
    body: 'See an agent write its own tool when nothing installed fits, and everything Galaxy records along the way.',
  },
  {
    href: '/tools/user-defined-tools/',
    title: 'User-defined tools',
    body: 'The small YAML tools an agent can write and run in your account. In beta, enabled per account.',
  },
  {
    href: 'https://github.com/galaxyproject/galaxy-mcp',
    title: 'Galaxy MCP server',
    body: 'The connection underneath both paths, for building Galaxy into your own agent or app.',
    external: true,
  },
];
---

<div class="agl not-prose">
  <section class="agl-hero">
    <div class="agl-hero__grid bg-grid-dark" aria-hidden="true"></div>
    <div class="agl-hero__inner">
      <h1 class="agl-title">Put an <em>AI agent</em> to work on Galaxy</h1>
      <p class="agl-lede">
        Talk through your data, approve a plan, and let an agent run it on Galaxy, with every step recorded in your
        history.
      </p>

      <article class="agl-orbit" aria-labelledby="agl-orbit-title">
        <figure class="agl-orbit__shot">
          <img
            src="/images/agents/orbit/orbit-interface-overview.png"
            alt="Orbit with a plan the agent drafted, waiting for approval, next to the phylogenetic tree it produced"
            width="2000"
            height="1111"
            decoding="async"
          />
        </figure>
        <div class="agl-orbit__text">
          <p class="agl-orbit__ask">Just want to get started?</p>
          <h2 class="agl-orbit__title" id="agl-orbit-title">Use Orbit</h2>
          <p class="agl-orbit__body">
            Orbit is a desktop app with Galaxy already connected and the Galaxy skills built in. Tell it what you want
            to find out; it drafts a plan, waits for your go-ahead, runs the steps on Galaxy and keeps a notebook of
            what it did.
          </p>
          <p class="agl-orbit__meta">
            For macOS, Linux and Windows. Orbit is in beta, and you bring the model: an API key, or a ChatGPT sign-in.
          </p>
          <div class="agl-orbit__actions">
            <a class="agl-btn agl-btn--gold" href="/agents/orbit/"
              >Install Orbit <Fragment set:html={svg(icons.arrow)} /></a
            >
            <a class="agl-link" href="https://galaxyproject.github.io/loom/">How Orbit works</a>
          </div>
        </div>
      </article>

      <div class="agl-own">
        <p class="agl-own__text">
          <strong>Already have a coding agent you like?</strong>
          Add Galaxy to Claude Code, Codex, Antigravity, Pi or Claude Desktop with the Galaxy plugin set.
        </p>
        <a class="agl-btn agl-btn--outline" href="/agents/plugins/">Set up your agent</a>
      </div>
    </div>
  </section>

  <section class="agl-more" aria-label="More in this section">
    <ul class="agl-more__list">
      {
        more.map((m) => (
          <li>
            <a class="agl-tile" href={m.href} {...(m.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="agl-tile__bar" aria-hidden="true" />
              <span class="agl-tile__title">{m.title}</span>
              <span class="agl-tile__body">{m.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<div class="agl-prose">
  <slot />
</div>

<style>
  .agl {
    --agl-dark: var(--color-galaxy-dark, #2c3143);
    --agl-primary: var(--color-galaxy-primary, #25537b);
    --agl-gold: var(--color-galaxy-gold, #ffd700);
    --agl-gold-dark: var(--color-galaxy-gold-dark, #d19e00);
    --agl-grey: var(--color-galaxy-grey, #58585a);
    --agl-light: var(--color-light-bg, #edf4fa);
    /* Cancel the article padding so the hero runs edge to edge, as on the other agent pages. */
    margin: -1.5rem -1.5rem 0;
  }

  @media (min-width: 640px) {
    .agl {
      margin: -1.5rem -2rem 0;
    }
  }

  /* The hub's unlayered .prose rules outrank component classes; reset them here. */
  .agl :is(h1, h2, p, figure) {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .agl a,
  .agl a:hover {
    text-decoration: none;
  }

  /* ---- Hero ---- */

  .agl-hero {
    position: relative;
    background: linear-gradient(135deg, var(--agl-dark) 0%, var(--agl-primary) 100%);
    color: #fff;
  }

  .agl-hero__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .agl-hero__inner {
    position: relative;
    max-width: 68rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 3rem;
  }

  @media (min-width: 640px) {
    .agl-hero__inner {
      padding: 4rem 2.5rem 3.5rem;
    }
  }

  .agl .agl-title {
    max-width: 22ch;
    margin: 0 auto;
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-align: center;
    color: #fff;
    text-wrap: balance;
  }

  .agl-title em {
    font-style: normal;
    color: var(--agl-gold);
  }

  .agl .agl-lede {
    max-width: 40rem;
    margin: 1.1rem auto 2.5rem;
    font-size: clamp(1.02rem, 1.7vw, 1.18rem);
    line-height: 1.55;
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
    text-wrap: pretty;
  }

  /* ---- Orbit: the default path ---- */

  .agl-orbit {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: 0.5rem;
    background: #fff;
    color: var(--agl-dark);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  @media (min-width: 880px) {
    .agl-orbit {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }

  .agl-orbit__shot {
    display: flex;
    align-items: center;
    padding: 1rem 0.75rem;
    background: var(--agl-light);
  }

  .agl-orbit__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .agl-orbit__text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem 1.75rem;
  }

  @media (min-width: 880px) {
    .agl-orbit__text {
      justify-content: center;
      padding: 2.25rem 2.25rem 2.25rem 2rem;
    }
  }

  .agl .agl-orbit__ask {
    font-size: 1rem;
    font-weight: 700;
    color: var(--agl-primary);
  }

  .agl .agl-orbit__title {
    margin-top: -0.35rem;
    font-size: clamp(1.75rem, 3vw, 2.1rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--agl-dark);
  }

  .agl .agl-orbit__body {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--agl-grey);
  }

  .agl .agl-orbit__meta {
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--agl-grey) 80%, transparent);
  }

  .agl-orbit__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  /* ---- Buttons (DESIGN.md brand CTAs) ---- */

  .agl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .agl-btn :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .agl a.agl-btn--gold {
    background: var(--agl-gold);
    color: var(--agl-dark);
  }

  .agl a.agl-btn--gold:hover {
    background: var(--agl-gold-dark);
  }

  .agl a.agl-btn--outline {
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: #fff;
  }

  .agl a.agl-btn--outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .agl a.agl-link {
    font-weight: 700;
    color: var(--agl-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--agl-primary) 35%, transparent);
    text-underline-offset: 3px;
  }

  .agl a.agl-link:hover {
    text-decoration-color: var(--agl-gold-dark);
  }

  /* ---- Bring your own agent: the secondary path ---- */

  .agl-own {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.5rem;
  }

  @media (min-width: 720px) {
    .agl-own {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .agl .agl-own__text {
    max-width: 44rem;
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  .agl-own__text strong {
    color: #fff;
  }

  /* ---- Pointers into the rest of the section ---- */

  .agl-more {
    background: var(--agl-light);
  }

  .agl-more__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    list-style: none;
  }

  @media (min-width: 640px) {
    .agl-more__list {
      padding: 2.5rem 2.5rem;
    }
  }

  @media (min-width: 880px) {
    .agl-more__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .agl-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    overflow: hidden;
    padding: 1.25rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--agl-primary) 10%, transparent);
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    transition: box-shadow 0.2s ease;
  }

  /* DESIGN.md's signature hover: a gold bar grows in from the left edge. */
  .agl-tile__bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--agl-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .agl-tile:hover {
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  .agl-tile:hover .agl-tile__bar,
  .agl-tile:focus-visible .agl-tile__bar {
    transform: scaleX(1);
  }

  .agl-tile__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--agl-dark);
  }

  .agl-tile__body {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--agl-grey);
  }

  .agl-btn:focus-visible,
  .agl-link:focus-visible,
  .agl-tile:focus-visible {
    outline: 2px solid var(--agl-gold);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .agl-btn,
    .agl-tile,
    .agl-tile__bar {
      transition: none;
    }
  }

  /* ---- The page's own markdown ---- */

  .agl-prose {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0.25rem 0.25rem 1rem;
  }

  @media print {
    .agl-hero {
      background: none;
      color: #000;
    }
    .agl-hero__grid,
    .agl-orbit__shot {
      display: none;
    }
    .agl-title,
    .agl-title em,
    .agl-lede,
    .agl-own__text,
    .agl-own__text strong,
    .agl a.agl-btn--outline {
      color: #000;
    }
    .agl-orbit,
    .agl-more {
      box-shadow: none;
      background: none;
    }
  }
</style>
