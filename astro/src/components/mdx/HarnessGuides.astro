---
/**
 * HarnessGuides: compact header + 6-tab harness selector + numbered Step 1/2/3
 * cards for /agents/.
 *
 * Without JavaScript every panel is visible, stacked, and tabs are plain
 * anchors. With JavaScript one panel shows at a time, URL hash tracks selection
 * (#guide-<id>), and legacy #guide-pi / #guide-cursor hashes open the "other"
 * panel at the matching sub-heading.
 */
import bandsCss from '../agent-pages/bands.css?raw';
import { harnessIcons } from '../agent-pages/harness-icons';

const tabs = [
  { id: 'orbit', name: 'Orbit', tag: 'Desktop app · Galaxy built in', accent: '#eab308' },
  { id: 'claude-code', name: 'Claude Code', tag: 'CLI · keychain prompt', accent: '#d97757' },
  { id: 'codex', name: 'Codex CLI', tag: 'CLI · shell or .env', accent: '#4f46e5' },
  { id: 'antigravity', name: 'Antigravity', tag: 'CLI & IDE · shell or .env', accent: '#4285f4' },
  { id: 'claude-desktop', name: 'Claude Desktop', tag: 'No terminal · .mcpb', accent: '#d97757' },
  { id: 'other', name: 'Pi / Cursor / Other', tag: 'MCP + Agent Skills', accent: '#0d9488' },
];
---

<style is:global set:html={bandsCss}></style>

<section class="ag-top not-prose">
  <div class="ag-top__hero">
    <div class="ag-top__grid bg-grid-dark" aria-hidden="true"></div>
    <div class="ag-top__inner">
      <h1 class="ag-top__title">Use Galaxy from your <em>AI agent</em></h1>
      <p class="ag-top__lede">
        Follow Steps 1–4 below — every tool, workflow, and custom container runs as a tracked job in your Galaxy
        history.
      </p>
    </div>
  </div>
</section>

<div class="ag-band ag-band--guides">
  <div class="hguides" data-harness-guides>
    <div class="hstep hstep--picker not-prose">
      <div class="hstep__badge" aria-hidden="true">1</div>
      <div class="hstep__body">
        <h3 class="hstep__picker-title"><span class="hstep__kicker">Step 1:</span> Pick your agent</h3>
        <div class="hguides__tabs" role="tablist" aria-label="Pick your agent">
          {tabs.map((t, i) => <a
            class:list={['hguides__tab', i === 0 && 'is-active']}
            role="tab"
            id={`guide-tab-${t.id}`}
            href={`#guide-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`guide-${t.id}`}
            tabindex={i === 0 ? 0 : -1}
            data-guide-tab={t.id}
            style={`--ash-accent: ${t.accent}`}
          >
            <span class="hguides__logo" aria-hidden="true">
              <Fragment set:html={harnessIcons[t.id]} />
            </span>
            <span class="hguides__txt">
              <span class="hguides__name">{t.name}</span>
              <span class="hguides__tag">{t.tag}</span>
            </span>
          </a>)}
        </div>
      </div>
    </div>
    <div class="hguides__panels">
      <slot />
    </div>
  </div>
</div>

<style is:global>
  .ag-top {
    --ag-dark: var(--color-galaxy-dark, #2c3143);
    --ag-primary: var(--color-galaxy-primary, #25537b);
    --ag-gold: var(--color-galaxy-gold, #ffd700);
    margin: -1.5rem -1.5rem 0;
  }

  @media (min-width: 640px) {
    .ag-top {
      margin: -1.5rem -2rem 0;
    }
  }

  .ag-top__hero {
    position: relative;
    background: linear-gradient(135deg, var(--ag-dark) 0%, var(--ag-primary) 100%);
    border-bottom: 4px solid var(--ag-gold);
    color: #fff;
  }

  .ag-top__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ag-top__inner {
    position: relative;
    max-width: 84rem;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 2rem;
  }

  @media (min-width: 640px) {
    .ag-top__inner {
      padding: 2.6rem 2.25rem 2.3rem;
    }
  }

  /* Widen all bands on /agents/ so the page uses modern monitor width cleanly. */
  .prose .ag-top ~ .ag-band {
    padding-left: max(1.5rem, calc((100% + 3rem - 84rem) / 2));
    padding-right: max(1.5rem, calc((100% + 3rem - 84rem) / 2));
  }

  @media (min-width: 640px) {
    .prose .ag-top ~ .ag-band {
      padding-left: max(2.25rem, calc((100% + 4rem - 84rem) / 2));
      padding-right: max(2.25rem, calc((100% + 4rem - 84rem) / 2));
    }
  }

  .prose .ag-top ~ .ag-band > p,
  .prose .ag-top ~ .ag-band > ul {
    max-width: 64rem;
  }

  .prose .ag-top ~ .ag-band--white .ag-example {
    background: color-mix(in srgb, var(--color-light-bg, #edf4fa) 48%, #fff);
  }

  .ag-top .ag-top__title {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: clamp(2rem, 4.2vw, 2.85rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }

  .ag-top__title em {
    font-style: normal;
    color: var(--ag-gold);
  }

  .ag-top .ag-top__lede {
    max-width: 54rem;
    margin: 0.65rem 0 0;
    font-size: clamp(1rem, 1.45vw, 1.12rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    text-wrap: pretty;
  }

  .prose .ag-band--guides {
    padding-top: 2.25rem;
    padding-bottom: 3.25rem;
  }

  .hguides {
    margin: 0;
  }

  .hstep--picker {
    margin-bottom: 1.15rem;
  }

  .hstep__picker-title {
    margin: 0.1rem 0 1rem;
    padding: 0;
    border: 0;
    font-size: clamp(1.22rem, 1.8vw, 1.42rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-galaxy-dark, #2c3143);
  }

  .hguides__tabs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
    margin: 0;
  }

  @media (min-width: 560px) {
    .hguides__tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .hguides__tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hguides__tab,
  .prose .hguides__tab {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.05rem;
    border: 1px solid color-mix(in srgb, var(--color-galaxy-primary, #25537b) 18%, transparent);
    border-bottom: 3px solid color-mix(in srgb, var(--color-galaxy-primary, #25537b) 18%, transparent);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--color-light-bg, #edf4fa) 55%, #fff);
    color: var(--color-galaxy-dark, #2c3143);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .hguides__tab:hover,
  .prose .hguides__tab:hover {
    background: #fff;
    border-color: color-mix(in srgb, var(--color-galaxy-primary, #25537b) 40%, transparent);
    text-decoration: none;
  }

  .hguides__tab.is-active,
  .prose .hguides__tab.is-active {
    background: #fff;
    border: 2px solid var(--color-galaxy-primary, #25537b);
    border-bottom: 4px solid var(--ash-accent, #25537b);
    box-shadow: 0 4px 14px rgba(16, 32, 52, 0.11);
  }

  /* The active tab's own shadow would replace the global inner ring. */
  .hguides__tab.is-active:focus-visible,
  .prose .hguides__tab.is-active:focus-visible {
    box-shadow:
      0 0 0 2px var(--color-focus-inner),
      0 4px 14px rgba(16, 32, 52, 0.11);
  }

  .hguides__logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.45rem;
    height: 2.45rem;
    border-radius: 0.55rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-galaxy-primary, #25537b) 16%, transparent);
    box-shadow: 0 1px 2px rgba(16, 32, 52, 0.05);
  }

  .hguides__logo svg {
    display: block;
  }

  .hguides__tab.is-active .hguides__logo {
    border-color: color-mix(in srgb, var(--ash-accent, #25537b) 55%, transparent);
    box-shadow: 0 1px 4px rgba(16, 32, 52, 0.1);
  }

  .hguides__txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hguides__name {
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-galaxy-dark, #2c3143);
  }

  .hguides__tag {
    margin-top: 0.16rem;
    font-size: 0.78rem;
    line-height: 1.25;
    color: var(--color-galaxy-grey, #58585a);
  }

  .hguide {
    scroll-margin-top: 5rem;
  }

  /* Remove narrow 65ch prose clamps inside guide cards and details drawers. */
  .prose .hguide p,
  .prose .hguide ul,
  .prose .hguide ol,
  .prose .hguide li,
  .prose .hguide details {
    max-width: none;
  }

  /* No JS: guides stack with their own titles. With JS: tabs own the title. */
  .hguide + .hguide {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-galaxy-primary, #25537b) 25%, transparent);
  }

  .hguides.has-js .hguide + .hguide {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .hguides.has-js .hguide[hidden] {
    display: none;
  }

  .hguides.has-js .hguide__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .prose .hguide__title {
    margin-top: 1.5em;
    border: 0;
  }

  /* Large numbered Step 1 / 2 / 3 cards inside each harness panel. */
  .prose .hstep {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.4rem 1.35rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-galaxy-primary, #25537b) 16%, transparent);
    border-radius: 0.85rem;
    box-shadow: 0 2px 10px rgba(16, 32, 52, 0.05);
  }

  .prose .hstep + .hstep {
    margin-top: 1.15rem;
  }

  @media (min-width: 680px) {
    .prose .hstep {
      grid-template-columns: 3.85rem minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.75rem 2.15rem;
      align-items: start;
    }
  }

  .hstep__badge {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 0.85rem;
    background: var(--color-galaxy-primary, #25537b);
    border-bottom: 4px solid var(--color-galaxy-gold, #ffd700);
    color: #fff;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(37, 83, 123, 0.22);
  }

  @media (min-width: 680px) {
    .hstep__badge {
      width: 3.75rem;
      height: 3.75rem;
      font-size: 1.9rem;
    }
  }

  .prose .hstep__body {
    min-width: 0;
  }

  .prose .hstep__body > :first-child {
    margin-top: 0;
  }

  .prose .hstep__body > :last-child {
    margin-bottom: 0;
  }

  .prose .hstep__body > h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0.1rem 0 0.9rem;
    padding: 0;
    border: 0;
    font-size: clamp(1.22rem, 1.8vw, 1.42rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-galaxy-dark, #2c3143);
  }

  .prose .hstep__kicker,
  .hstep__kicker {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .prose .hstep__body p,
  .prose .hstep__body li {
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .prose .hstep__body :is(ul, ol) {
    margin: 0.5rem 0 0.85rem;
    padding-left: 1.35rem;
  }

  .prose .hstep__body li + li {
    margin-top: 0.5rem;
  }

  .prose .hstep__body :is(.code-block, pre) {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .prose .hstep__body > :is(.code-block, pre):last-child {
    margin-bottom: 0;
  }

  .prose .hguide h5 {
    font-size: 1.06rem;
    font-weight: 700;
    color: var(--color-galaxy-dark, #2c3143);
    margin-top: 1.35rem;
    margin-bottom: 0.45rem;
    scroll-margin-top: 5rem;
  }

  .prose .hguide > details {
    box-sizing: border-box;
    width: 100%;
    max-width: none !important;
    margin-top: 1.25rem;
    padding: 0.95rem 1.4rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-galaxy-primary, #25537b) 16%, transparent);
    border-radius: 0.75rem;
  }

  .prose .hguide > details > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-galaxy-primary, #25537b);
  }

  .prose .hguide > details[open] > summary {
    margin-bottom: 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-galaxy-primary, #25537b) 12%, transparent);
  }

  .hguide__source {
    margin-top: 1.25rem;
    padding-top: 0;
    border-top: 0;
    font-size: 0.84rem;
    color: var(--color-galaxy-grey, #4b5563);
  }

  @media print {
    .ag-top__hero {
      background: none;
      color: #000;
      border-bottom: 1px solid #000;
    }
    .ag-top .ag-top__title,
    .ag-top__title em,
    .ag-top .ag-top__lede {
      color: #000;
    }
  }
</style>

<script>
  const HASH_PREFIX = '#guide-';
  const ALIASES: Record<string, { panel: string; sub?: string }> = {
    pi: { panel: 'other', sub: 'pi' },
    cursor: { panel: 'other', sub: 'cursor' },
  };

  function mount(root: HTMLElement) {
    if (root.dataset.mounted === '1') return;
    root.dataset.mounted = '1';
    root.classList.add('has-js');

    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-guide-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-guide-panel]'));
    const ids = tabs.map((t) => t.dataset.guideTab ?? '');

    function resolve(raw: string): { panel: string; sub?: string } | null {
      if (ids.includes(raw)) return { panel: raw };
      return ALIASES[raw] ?? null;
    }

    function select(raw: string, opts: { hash?: boolean } = {}) {
      const target = resolve(raw);
      if (!target) return null;
      tabs.forEach((t) => {
        const active = t.dataset.guideTab === target.panel;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.tabIndex = active ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.guidePanel !== target.panel;
      });
      if (opts.hash) history.replaceState(history.state, '', `${HASH_PREFIX}${raw}`);
      return target;
    }

    function reveal(target: { panel: string; sub?: string }) {
      const panel = panels.find((p) => p.dataset.guidePanel === target.panel);
      if (target.sub) {
        panel?.querySelector<HTMLElement>(`#${target.sub}`)?.scrollIntoView({ block: 'start', behavior: 'auto' });
        return;
      }
      const rect = root.getBoundingClientRect();
      if (rect.top < 0 || rect.top > window.innerHeight * 0.6) {
        root.scrollIntoView({ block: 'start', behavior: 'auto' });
      }
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        select(ids[i], { hash: true });
      });
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % n;
        else if (e.key === 'ArrowLeft') next = (i - 1 + n) % n;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = n - 1;
        if (next < 0) return;
        e.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      });
    });

    const onDocClick = (e: MouseEvent) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(`a[href^="${HASH_PREFIX}"]`);
      if (!a || a.dataset.guideTab !== undefined) return;
      const raw = a.getAttribute('href')!.slice(HASH_PREFIX.length);
      const target = select(raw, { hash: true });
      if (!target) return;
      e.preventDefault();
      reveal(target);
    };
    document.addEventListener('click', onDocClick, true);

    const onHash = () => {
      const h = location.hash;
      if (!h.startsWith(HASH_PREFIX)) return;
      const target = select(h.slice(HASH_PREFIX.length));
      if (target) reveal(target);
    };
    window.addEventListener('hashchange', onHash);

    if (location.hash.startsWith(HASH_PREFIX)) {
      const target = select(location.hash.slice(HASH_PREFIX.length));
      if (target) {
        reveal(target);
      } else {
        select(ids[0]);
      }
    } else {
      select(ids[0]);
    }

    return () => {
      document.removeEventListener('click', onDocClick, true);
      window.removeEventListener('hashchange', onHash);
      delete root.dataset.mounted;
    };
  }

  let teardown: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = undefined;
    const root = document.querySelector<HTMLElement>('[data-harness-guides]');
    if (root) teardown = mount(root);
  });
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = undefined;
  });
</script>
