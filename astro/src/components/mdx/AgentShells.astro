---
/**
 * AgentShells: dark hero + live animated replay of installing the Galaxy
 * plugins into the supported AI agent harnesses. Used from MDX as <AgentShells />.
 * Scene data: ../agent-shells/scenes.ts; runtime: ../agent-shells/player.ts.
 */
import shellsCss from '../agent-shells/shells.css?raw';
import bandsCss from '../agent-pages/bands.css?raw';
import { scenes } from '../agent-shells/scenes';
import { finalBodyHtml, sceneSummary } from '../agent-shells/render';
import { icons, svg } from '../../lib/icons';

// The stylesheet is inlined as a raw string so it ships only on pages that
// render this component (a CSS import would join every route's CSS chunk).
const COPY_LABEL_DEFAULT = 'Copy install commands';

const first = scenes[0];
const initialBody = first ? finalBodyHtml(first) : '';
const initialSummary = first ? sceneSummary(first) : '';

const pillars = [
  {
    title: 'A Galaxy connection',
    text: 'The galaxy-mcp server, authenticated with your API key: histories, datasets, tools and workflows on any Galaxy server you have an account on.',
    href: 'https://github.com/galaxyproject/galaxy-mcp',
    label: 'galaxy-mcp',
    icon: icons.plug,
  },
  {
    title: 'Curated skills',
    text: 'galaxy-skills for using Galaxy (collections, user-defined tools, workflow reports, reproducibility) and galaxy-dev-skills for building it (tool wrappers, Nextflow conversion, ToolShed).',
    href: 'https://github.com/galaxyproject/galaxy-skills',
    label: 'galaxy-skills',
    icon: icons.sparkles,
  },
  {
    title: 'Workflow Foundry',
    text: 'Skills that turn papers, Nextflow pipelines and CWL workflows into validated Galaxy workflows, tested end to end.',
    href: 'https://github.com/galaxyproject/foundry',
    label: 'foundry',
    icon: icons.workflow,
  },
];

const sideItems = [
  { key: 'Customize', icon: icons.sliders },
  { key: 'MCP', icon: icons.plug },
  { key: 'Skills', icon: icons.sparkle },
];
const hasIde = scenes.some((s) => s.kind === 'ide');
---

<style is:global set:html={shellsCss + bandsCss}></style>
<noscript set:html={'<style>.agent-shells .ash-window { height: auto; }</style>'} />

<section class="agent-shells not-prose" data-agent-shells style={`--ash-accent: ${first?.accent ?? '#ffd700'}`}>
  <div class="ash-hero">
    <div class="ash-hero__grid bg-grid-dark" aria-hidden="true"></div>
    <div class="ash-hero__inner">
      <h1 class="ash-title">Galaxy for <em>AI coding agents</em></h1>
      <p class="ash-lede">
        Give the coding agent you already use a Galaxy connection and curated Galaxy skills, in one install.
      </p>
      <div class="ash-cta">
        <a class="ash-btn" href="#set-up-your-agent">Set up your agent <Fragment set:html={svg(icons.arrow)} /></a>
        <a class="ash-btn ash-btn--ghost" href="/agents/orbit/">Prefer a desktop app? Try Orbit</a>
      </div>
    </div>

    <div class="ash-demo">
      <div class="ash-tabs" role="tablist" aria-label="Agent harness">
        {scenes.map((s, i) => <button
          class:list={['ash-tab', i === 0 && 'is-active']}
          type="button"
          role="tab"
          id={`ash-tab-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="ash-window"
          tabindex={i === 0 ? 0 : -1}
          data-tab={s.id}
          style={`--ash-accent: ${s.accent}`}
        >
          <span class="ash-mono" aria-hidden="true">
            {s.monogram}
          </span>
          <span class="ash-tab__text">
            <span class="ash-tab__name">{s.name}</span>
            <span class="ash-tab__tag">{s.tagline}</span>
          </span>
        </button>)}
      </div>
      <div class="ash-progress" aria-hidden="true"><span data-progress></span></div>

      <div
        class="ash-window"
        id="ash-window"
        role="tabpanel"
        aria-labelledby={`ash-tab-${first?.id ?? ''}`}
        data-window
        data-kind={first?.kind ?? 'terminal'}
        style={`--ash-accent: ${first?.accent ?? '#ffd700'}`}
      >
        <p class="sr-only" data-summary aria-live="polite">{initialSummary}</p>
        <div class="ash-bar">
          <span class="ash-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="ash-bar__title" data-title>{first?.title ?? ''}</span>
          <span class="ash-bar__spacer" aria-hidden="true"></span>
        </div>
        <div class="ash-frame">
          {hasIde && <aside class="ash-side" aria-hidden="true">
            <div class="ash-side__hd">Settings</div>
            {sideItems.map((it) => <div class="ash-side__item" data-side-item={it.key}>
              <Fragment set:html={svg(it.icon)} />
              {it.key}
            </div>)}
            <div class="ash-side__pane">Agent · chat</div>
          </aside>}
          <div
            class="ash-body"
            data-body
            role="region"
            aria-label="Replay transcript"
            aria-live="off"
            tabindex="0"
            set:html={initialBody}
          />
        </div>
      </div>

      <div class="ash-controls">
        <button class="ash-ctl" type="button" data-play data-state="playing">
          <span class="ic-pause"><Fragment set:html={svg(icons.pause)} /></span>
          <span class="ic-play"><Fragment set:html={svg(icons.play)} /></span>
          <span class="lbl">Pause</span>
        </button>
        <button class="ash-ctl" type="button" data-replay>
          <Fragment set:html={svg(icons.replay)} />
          <span class="lbl">Replay</span>
        </button>
        <div class="ash-controls__right">
          <button class="ash-ctl" type="button" data-copy data-copy-text={first?.copy ?? ''}>
            <Fragment set:html={svg(icons.copy)} />
            <span class="lbl">{first?.copyLabel ?? COPY_LABEL_DEFAULT}</span>
          </button>
          <a class="ash-ctl ash-ctl--link" href={first?.href ?? '#set-up-your-agent'} data-setup>
            <span class="lbl">Set up {first?.name ?? 'your agent'}</span>
            <Fragment set:html={svg(icons.arrow)} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-pillars">
    <div class="ash-pillars__inner">
      <h2>What one install gives your agent</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {pillars.map((p) => <div
          class="bg-white border border-galaxy-primary/10 rounded-lg shadow-sm p-6 flex flex-col gap-3"
        >
          <span
            class="inline-grid place-items-center w-10 h-10 rounded-md bg-galaxy-primary/10 text-galaxy-primary [&>svg]:w-5 [&>svg]:h-5"
            set:html={svg(p.icon)}
          />
          <h3 class="text-lg font-semibold text-galaxy-dark leading-snug">{p.title}</h3>
          <p class="text-sm text-galaxy-grey leading-relaxed flex-1">{p.text}</p>
          <a
            class="ash-link inline-flex items-center gap-1.5 text-sm font-semibold transition-colors [&>svg]:w-4 [&>svg]:h-4"
            href={p.href}
            rel="noopener noreferrer"
            target="_blank"
          >
            {p.label}
            <Fragment set:html={svg(icons.arrow)} />
          </a>
        </div>)}
      </div>
    </div>
  </div>
</section>

<script>
  import { scenes } from '../agent-shells/scenes';
  import { mountAgentShells } from '../agent-shells/player';

  let teardown: (() => void) | null = null;

  function init() {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-agent-shells]');
    if (root) teardown = mountAgentShells(root, scenes);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
