---
/**
 * AgentShells: dark hero + live animated replay of installing the Galaxy
 * plugins into the supported AI agent harnesses. Used from MDX as <AgentShells />.
 * Scene data: ../agent-shells/scenes.ts; runtime: ../agent-shells/player.ts.
 */
import shellsCss from '../agent-shells/shells.css?raw';
import { scenes } from '../agent-shells/scenes';
import { finalBodyHtml, sceneSummary } from '../agent-shells/render';
import { icons, svg } from '../../lib/icons';

// The stylesheet is inlined as a raw string so it ships only on pages that
// render this component (a CSS import would join every route's CSS chunk).
const COPY_LABEL_DEFAULT = 'Copy install commands';

const first = scenes[0];
const initialBody = first ? finalBodyHtml(first) : '';
const initialSummary = first ? sceneSummary(first) : '';

const pillars = [
  {
    title: 'A Galaxy connection',
    text: 'The galaxy-mcp server, authenticated with your API key: histories, datasets, tools and workflows on any Galaxy server you have an account on.',
    href: 'https://github.com/galaxyproject/galaxy-mcp',
    label: 'galaxy-mcp',
    icon: icons.plug,
  },
  {
    title: 'Curated skills',
    text: 'galaxy-skills for using Galaxy (collections, user-defined tools, workflow reports, reproducibility) and galaxy-dev-skills for building it (tool wrappers, Nextflow conversion, ToolShed).',
    href: 'https://github.com/galaxyproject/galaxy-skills',
    label: 'galaxy-skills',
    icon: icons.sparkles,
  },
  {
    title: 'Workflow Foundry',
    text: 'Skills that turn papers, Nextflow pipelines and CWL workflows into validated Galaxy workflows, tested end to end.',
    href: 'https://github.com/galaxyproject/foundry',
    label: 'foundry',
    icon: icons.workflow,
  },
];

// Restrained "galaxy" of nodes + filaments for the hero background (viewBox 1000x600).
const nodes: Array<[number, number, number, boolean?]> = [
  [70, 80, 2.2],
  [190, 50, 2.6, true],
  [320, 130, 2],
  [140, 220, 3],
  [60, 340, 2, true],
  [260, 300, 2.2],
  [430, 60, 2.4],
  [560, 120, 2],
  [700, 70, 2.4],
  [640, 240, 3.2, true],
  [770, 190, 2],
  [900, 120, 2.2, true],
  [940, 280, 2],
  [830, 330, 2.6],
  [880, 470, 2.2],
  [130, 480, 2, true],
  [360, 520, 2.2],
  [660, 520, 2.4],
];
const edges: Array<[number, number]> = [
  [0, 1],
  [1, 2],
  [0, 3],
  [3, 5],
  [3, 4],
  [2, 6],
  [6, 7],
  [7, 9],
  [9, 5],
  [7, 8],
  [8, 10],
  [10, 9],
  [10, 11],
  [11, 12],
  [12, 13],
  [13, 9],
  [13, 14],
  [4, 15],
  [15, 16],
  [16, 5],
  [16, 17],
  [17, 14],
  [17, 9],
];

const sideItems = [
  { key: 'Customize', icon: icons.sliders },
  { key: 'MCP', icon: icons.plug },
  { key: 'Skills', icon: icons.sparkle },
];
const hasIde = scenes.some((s) => s.kind === 'ide');
---

<style is:global set:html={shellsCss}></style>
<noscript set:html={'<style>.agent-shells .ash-window { height: auto; }</style>'} />

<section class="agent-shells not-prose" data-agent-shells style={`--ash-accent: ${first?.accent ?? '#ffd700'}`}>
  <div class="ash-hero">
    <div class="ash-hero__grid bg-grid-dark" aria-hidden="true"></div>
    <svg class="ash-cosmos" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none">
      <defs>
        <radialGradient id="ash-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffd700" stop-opacity="0.85"></stop>
          <stop offset="100%" stop-color="#ffd700" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <g stroke="#8fb9dd" stroke-opacity="0.08" stroke-width="1">
        {edges.map(([a, b]) => <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} />)}
      </g>
      <g>
        {
          nodes.map(([x, y, r, gold], i) =>
            gold ? (
              <>
                <circle
                  class="glow"
                  cx={x}
                  cy={y}
                  r={r * 4}
                  fill="url(#ash-glow)"
                  opacity="0.45"
                  style={`animation-delay: ${-(i % 3) * 1.8}s`}
                />
                <circle cx={x} cy={y} r={r} fill="#ffd700" fill-opacity="0.75" />
              </>
            ) : (
              <circle cx={x} cy={y} r={r} fill="#aecce7" fill-opacity="0.28" />
            )
          )
        }
      </g>
    </svg>

    <div class="ash-hero__inner">
      <p class="ash-eyebrow">Galaxy MCP · galaxy-skills · Foundry</p>
      <h1 class="ash-title">Galaxy for <em>AI coding agents</em></h1>
      <p class="ash-lede">
        Connect Claude Code, Codex, Antigravity or Pi to any Galaxy server and give the agent curated Galaxy skills;
        Claude Desktop gets the Galaxy connection alone. <strong>One install:</strong> a Galaxy connection, the skills, the
        Workflow Foundry.
      </p>
      <div class="ash-cta">
        <a class="ash-btn ash-btn--gold" href="#pick-your-agent"
          >Pick your agent <Fragment set:html={svg(icons.arrow)} /></a
        >
        <a
          class="ash-btn ash-btn--ghost"
          href="https://github.com/galaxyproject/agentic-plugins"
          rel="noopener noreferrer"
          target="_blank"
        >
          <Fragment set:html={svg(icons.github)} /> GitHub
        </a>
      </div>
      <ul class="ash-chips" aria-label="Supported agents">
        {
          scenes.map((s) => (
            <li>
              <a class="ash-chip" href={s.href} style={`--ash-accent: ${s.accent}`}>
                <span class="ash-mono" aria-hidden="true">
                  {s.monogram}
                </span>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ash-demo">
      <div class="ash-tabs" role="tablist" aria-label="Agent harness">
        {
          scenes.map((s, i) => (
            <button
              class:list={['ash-tab', i === 0 && 'is-active']}
              type="button"
              role="tab"
              id={`ash-tab-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="ash-window"
              tabindex={i === 0 ? 0 : -1}
              data-tab={s.id}
              style={`--ash-accent: ${s.accent}`}
            >
              <span class="ash-mono" aria-hidden="true">
                {s.monogram}
              </span>
              <span class="ash-tab__text">
                <span class="ash-tab__name">{s.name}</span>
                <span class="ash-tab__tag">{s.tagline}</span>
              </span>
            </button>
          ))
        }
      </div>
      <div class="ash-progress" aria-hidden="true"><span data-progress></span></div>

      <div
        class="ash-window"
        id="ash-window"
        role="tabpanel"
        aria-labelledby={`ash-tab-${first?.id ?? ''}`}
        data-window
        data-kind={first?.kind ?? 'terminal'}
        style={`--ash-accent: ${first?.accent ?? '#ffd700'}`}
      >
        <p class="sr-only" data-summary aria-live="polite">{initialSummary}</p>
        <div class="ash-bar">
          <span class="ash-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="ash-bar__title" data-title>{first?.title ?? ''}</span>
          <span class="ash-bar__spacer" aria-hidden="true"></span>
        </div>
        <div class="ash-frame">
          {
            hasIde && (
              <aside class="ash-side" aria-hidden="true">
                <div class="ash-side__hd">Settings</div>
                {sideItems.map((it) => (
                  <div class="ash-side__item" data-side-item={it.key}>
                    <Fragment set:html={svg(it.icon)} />
                    {it.key}
                  </div>
                ))}
                <div class="ash-side__pane">Agent · chat</div>
              </aside>
            )
          }
          <div
            class="ash-body"
            data-body
            role="region"
            aria-label="Replay transcript"
            aria-live="off"
            tabindex="0"
            set:html={initialBody}
          />
        </div>
      </div>

      <div class="ash-controls">
        <button class="ash-ctl" type="button" data-play data-state="playing">
          <span class="ic-pause"><Fragment set:html={svg(icons.pause)} /></span>
          <span class="ic-play"><Fragment set:html={svg(icons.play)} /></span>
          <span class="lbl">Pause</span>
        </button>
        <button class="ash-ctl" type="button" data-replay>
          <Fragment set:html={svg(icons.replay)} />
          <span class="lbl">Replay</span>
        </button>
        <div class="ash-controls__right">
          <button class="ash-ctl" type="button" data-copy data-copy-text={first?.copy ?? ''}>
            <Fragment set:html={svg(icons.copy)} />
            <span class="lbl">{first?.copyLabel ?? COPY_LABEL_DEFAULT}</span>
          </button>
          <a class="ash-ctl ash-ctl--link" href={first?.href ?? '#pick-your-agent'} data-setup>
            <span class="lbl">Set up {first?.name ?? 'your agent'}</span>
            <Fragment set:html={svg(icons.arrow)} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-section ash-pillars">
    <div class="ash-section__inner">
      <div class="mb-4">
        <h2 class="ash-kicker text-xs font-bold uppercase tracking-[0.18em]">One install gives the agent</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          pillars.map((p) => (
            <div class="bg-white border border-galaxy-primary/10 rounded-lg shadow-sm p-6 flex flex-col gap-3">
              <span
                class="inline-grid place-items-center w-10 h-10 rounded-md bg-galaxy-primary/10 text-galaxy-primary [&>svg]:w-5 [&>svg]:h-5"
                set:html={svg(p.icon)}
              />
              <h3 class="text-lg font-semibold text-galaxy-dark leading-snug">{p.title}</h3>
              <p class="text-sm text-galaxy-grey leading-relaxed flex-1">{p.text}</p>
              <a
                class="ash-link inline-flex items-center gap-1.5 text-sm font-semibold transition-colors [&>svg]:w-4 [&>svg]:h-4"
                href={p.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {p.label}
                <Fragment set:html={svg(icons.arrow)} />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="ash-section ash-pick bg-white" id="pick-your-agent">
    <div class="ash-section__inner">
      <div class="flex items-center gap-3 mb-2">
        <span class="w-1 h-7 bg-galaxy-gold rounded-sm" aria-hidden="true"></span>
        <h2 class="text-2xl font-bold text-galaxy-dark">Pick your agent</h2>
      </div>
      <p class="text-galaxy-grey mb-6 max-w-2xl">
        Each guide walks through the install for that harness and starts with getting a Galaxy API key.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          scenes.map((s) => (
            <a
              class="group relative block overflow-hidden bg-white border border-galaxy-primary/10 rounded-lg shadow-sm p-5 no-underline hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
              href={s.href}
            >
              <span class="ash-card-bar" aria-hidden="true" />
              <span class="flex items-center gap-3 mb-2">
                <span
                  class="ash-mono !w-9 !h-9 !text-[0.8rem] !rounded-md"
                  style="color: var(--ash-primary); background: color-mix(in srgb, var(--ash-primary) 10%, #fff); border-color: color-mix(in srgb, var(--ash-primary) 30%, transparent)"
                  aria-hidden="true"
                >
                  {s.monogram}
                </span>
                <span class="text-lg font-semibold text-galaxy-dark">{s.name}</span>
              </span>
              <span class="block text-sm text-galaxy-grey leading-relaxed mb-3">{s.tagline}</span>
              <span class="ash-link inline-flex items-center gap-1.5 text-sm font-semibold transition-colors [&>svg]:w-4 [&>svg]:h-4">
                Set up
                <Fragment set:html={svg(icons.arrow)} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { scenes } from '../agent-shells/scenes';
  import { mountAgentShells } from '../agent-shells/player';

  let teardown: (() => void) | null = null;

  function init() {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-agent-shells]');
    if (root) teardown = mountAgentShells(root, scenes);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
