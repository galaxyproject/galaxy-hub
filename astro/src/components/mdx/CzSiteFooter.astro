---
import { textLink } from './linkClasses';
import SiteContactCard from './SiteContactCard.astro';

const links = [
  { href: 'mailto:galaxy@cesnet.cz', icon: 'mail', label: 'galaxy@cesnet.cz' },
  { href: 'https://help.galaxyproject.org/', icon: 'message-circle', label: 'Help Forum' },
  { href: 'https://github.com/cesnet', icon: 'github', label: 'GitHub' },
];
---

<SiteContactCard links={links}>
  <p class="mx-auto text-chicago-700">
    Galaxy Czechia is maintained by the <a class={textLink} href="/cz/people/">Czech Galaxy Team</a>, jointly supported
    by
    <a class={textLink} href="https://www.cesnet.cz/en">CESNET</a>
    and <a class={textLink} href="https://www.elixir-czech.cz/">ELIXIR Czechia</a>, as part of the wider Czech and
    European Galaxy community. All content on this site is available under
    <a class={textLink} href="https://creativecommons.org/share-your-work/public-domain/cc0/">CC0-1.0</a>
    unless otherwise specified.
  </p>
</SiteContactCard>
