---
/**
 * Compact rows of news posts or events (project pages, region homes): title, date line, teaser.
 * Events use the shared event date line (EventDate); news shows the publication date.
 */
import EventDate from '@/components/events/EventDate.astro';
import { formatDate } from '@/utils/dateUtils';

export interface ProjectRow {
  href: string;
  title: string;
  tease?: string | null;
  start?: Date | string | null;
  end?: Date | string | null;
}

interface Props {
  items: ProjectRow[];
  kind: 'news' | 'events';
  /** Events are past (muted date line) unless a page lists upcoming ones. */
  past?: boolean;
  /**
   * 'flat' (region homes, prototype A rows): the whole row is the link, title underlined only on
   * hover, gold bar and tinted row on hover, two-line teaser, short news dates.
   */
  variant?: 'project' | 'flat';
}

const { items, kind, past = true, variant = 'project' } = Astro.props;
const flat = variant === 'flat';

function isoDay(value: Date | string | null | undefined): string | undefined {
  if (!value) return undefined;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString().slice(0, 10);
}
---

<ol class:list={['project-rows', flat && 'project-rows--flat']} data-project-list={kind}>
  {items.map((item) => <li>
    <h3><a href={item.href}>{item.title}</a></h3>
    <p class="project-rows__meta">
      {kind === 'events' ? (
        <EventDate start={item.start} end={item.end} {past} />
      ) : (
        <time datetime={isoDay(item.start)}>{formatDate(item.start, flat)}</time>
      )}
    </p>
    {item.tease && <p class="project-rows__teaser">{item.tease}</p>}
  </li>)}
</ol>

<style>
  .project-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-rows li {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-chicago-100);
  }

  .project-rows h3 {
    margin: 0 0 4px;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 700;
  }

  .project-rows h3 a {
    color: var(--color-galaxy-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-rows h3 a:hover {
    text-decoration-color: var(--color-galaxy-gold);
  }

  .project-rows__meta {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-galaxy-grey);
  }

  .project-rows__teaser {
    margin: 4px 0 0;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-chicago-900);
  }
  /* Flat rows (prototype A .row): placed after the base rules so they win at equal specificity */
  .project-rows--flat li {
    position: relative;
    padding: 14px 12px 14px 14px;
    border-bottom-color: var(--gx-line);
    transition: background-color 0.15s;
  }

  .project-rows--flat li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 2px;
    background: var(--gx-accent-gold);
    transform: scaleY(0);
    transition: transform 0.2s;
  }

  .project-rows--flat li:hover {
    background: var(--gx-surface-2);
  }

  .project-rows--flat li:hover::before,
  .project-rows--flat li:focus-within::before {
    transform: scaleY(1);
  }

  .project-rows--flat h3 {
    color: var(--gx-fg-strong);
  }

  .project-rows--flat h3 a {
    color: inherit;
    text-decoration: none;
  }

  .project-rows--flat h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project-rows--flat li:hover h3 a {
    text-decoration: underline;
    text-decoration-color: var(--gx-link-hover-line);
    text-decoration-thickness: 2px;
  }

  .project-rows--flat h3 a:focus-visible {
    outline: none;
  }

  .project-rows--flat li:has(h3 a:focus-visible) {
    outline: 2px solid var(--gx-focus);
    outline-offset: -2px;
    border-radius: 6px;
  }

  .project-rows--flat .project-rows__teaser {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--gx-fg-meta);
  }

  @media (max-width: 639.98px) {
    .project-rows--flat li {
      padding: 12px 8px 12px 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-rows--flat li,
    .project-rows--flat li::before {
      transition: none;
    }
  }
</style>
