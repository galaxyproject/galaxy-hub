---
/**
 * Funding acknowledgement of a project (its funding_notice.md insert: funder emblem and statement).
 * Every project page shows it, as grant agreements ask for the acknowledgement on project material.
 */
import { render } from 'astro:content';
import { getInsert } from '@/utils/content';

interface Props {
  /** Insert slug, e.g. projects/esg/funding_notice. */
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;
const notice = await getInsert(slug);
const Notice = notice ? (await render(notice)).Content : null;
---

{Notice && <section class:list={['project-funding', className]} aria-labelledby="funding">
  <h2 id="funding" class="project-funding__title">Funding</h2>
  <div class="project-funding__body prose prose-galaxy max-w-none">
    <Notice />
  </div>
</section>}

<style>
  .project-funding__title {
    margin: 0 0 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-chicago-100);
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-galaxy-dark);
  }

  .project-funding__body :global(img) {
    width: 200px;
    height: auto;
    margin: 12px 0;
    padding: 4px;
    border-radius: 0.25rem;
    background: #f3f4f6;
  }
</style>
