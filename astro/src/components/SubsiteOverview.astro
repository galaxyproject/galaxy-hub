---
import type { CollectionEntry } from 'astro:content';
import RegionBand from './layout/RegionBand.astro';
import EventDate from './events/EventDate.astro';
import { formatDate } from '../utils/dateUtils';

interface Props {
  subsite: string;
  title: string;
  description: string;
  upcomingEvents: CollectionEntry<'events'>[];
  subsiteNews: CollectionEntry<'news'>[];
  hasMainContent?: boolean;
}

const { subsite, title, description, upcomingEvents, subsiteNews, hasMainContent = false } = Astro.props;

const moreLink =
  'text-sm font-bold text-link no-underline hover:text-link-hover hover:underline hover:decoration-link-hover-line hover:decoration-2';

function toIsoDate(date: Date | string | undefined): string | undefined {
  if (!date) return undefined;
  return (date instanceof Date ? date : new Date(date)).toISOString().slice(0, 10);
}
---

<div class="max-w-6xl mx-auto">
  <RegionBand {title} {description} />

  {hasMainContent && <div class="my-5 max-w-none subsite-inserts">
    <slot name="main-content" />
  </div>}

  <div class="region-home-grid">
    <section aria-labelledby="region-events">
      <div class="region-sec-head">
        <h2 id="region-events">Upcoming Events</h2>
        <a href={`/${subsite}/events/`} class={moreLink}>View all <span class="sr-only">{title} events</span></a>
      </div>

      {upcomingEvents.length === 0 ? (
        <p class="region-empty">No upcoming events.</p>
      ) : (
        <ol class="region-rows">
          {upcomingEvents.map((event) => <li class="region-row">
            <h3 class="region-row__title">
              <a class="region-row__link" href={`/${event.data.slug}/`}>{event.data.title}</a>
            </h3>
            <p class="region-row__meta"><EventDate start={event.data.date} end={event.data.end} /></p>
            {event.data.tease && <p class="region-row__teaser">{event.data.tease}</p>}
          </li>)}
        </ol>
      )}
    </section>

    <section aria-labelledby="region-news">
      <div class="region-sec-head">
        <h2 id="region-news">Recent News</h2>
        <a href={`/${subsite}/news/`} class={moreLink}>View all <span class="sr-only">{title} news</span></a>
      </div>

      {subsiteNews.length === 0 ? (
        <p class="region-empty">No recent news.</p>
      ) : (
        <ol class="region-rows">
          {subsiteNews.map((article) => <li class="region-row">
            <h3 class="region-row__title">
              <a class="region-row__link" href={`/${article.data.slug}/`}>{article.data.title}</a>
            </h3>
            <p class="region-row__meta">
              <time datetime={toIsoDate(article.data.date)}>{formatDate(article.data.date)}</time>
            </p>
            {article.data.tease && <p class="region-row__teaser">{article.data.tease}</p>}
          </li>)}
        </ol>
      )}
    </section>
  </div>

  <section class="mt-12 pt-8 border-t border-ebony-clay-100">
    <h2 class="text-xl font-bold text-galaxy-dark mb-4">Quick Links</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a
        href={`/${subsite}/events/`}
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">Events</h3>
        <p class="text-sm text-chicago-600">Browse all events</p>
      </a>
      <a
        href={`/${subsite}/news/`}
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">News</h3>
        <p class="text-sm text-chicago-600">Read latest news</p>
      </a>
      <a
        href="/use/"
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">Platforms</h3>
        <p class="text-sm text-chicago-600">Find Galaxy servers</p>
      </a>
      <a
        href="/community/"
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">Community</h3>
        <p class="text-sm text-chicago-600">Get involved</p>
      </a>
    </div>
  </section>

  <slot name="footer-content" />
</div>

<style>
  .region-home-grid {
    display: grid;
    gap: 32px 40px;
    margin-top: 32px;
  }

  @media (min-width: 1024px) {
    .region-home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Section head: h2 and "View all" over a hairline (prototype A .sec-head) */
  .region-sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--gx-line);
  }

  .region-sec-head h2 {
    margin: 0;
    font-size: var(--gx-text-h2);
    line-height: 1.3;
    font-weight: 700;
    color: var(--gx-fg-strong);
  }

  .region-empty {
    padding: 14px 0;
    color: var(--gx-fg-meta);
  }

  /* Flat rows: hairline between items, the whole row is the link, gold bar on hover and focus */
  .region-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .region-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 12px 14px 14px;
    border-bottom: 1px solid var(--gx-line);
    transition: background-color 0.15s;
  }

  .region-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 2px;
    background: var(--gx-accent-gold);
    transform: scaleY(0);
    transition: transform 0.2s;
  }

  .region-row:hover {
    background: var(--gx-surface-2);
  }

  .region-row:hover::before,
  .region-row:focus-within::before {
    transform: scaleY(1);
  }

  .region-row__title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--gx-fg-strong);
  }

  .region-row__link {
    color: inherit;
    text-decoration: none;
  }

  .region-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .region-row__link:hover {
    color: var(--gx-link-hover);
  }

  .region-row__link:focus-visible {
    outline: none;
  }

  .region-row:has(.region-row__link:focus-visible) {
    outline: 2px solid var(--gx-focus);
    outline-offset: -2px;
  }

  .region-row__meta {
    margin: 0;
    font-size: var(--gx-text-meta);
    line-height: 1.25rem;
    color: var(--gx-fg-meta);
  }

  .region-row__teaser {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: var(--gx-text-meta);
    line-height: 1.25rem;
    color: var(--gx-fg-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .region-row,
    .region-row::before {
      transition: none;
    }
  }

  .subsite-inserts :global(> *) {
    margin-bottom: 1.5rem;
  }

  .subsite-inserts :global(p:not([class])),
  .subsite-inserts :global(ul:not([class])),
  .subsite-inserts :global(ol:not([class])) {
    max-width: 65ch;
    line-height: 1.7;
  }

  .subsite-inserts :global(ul:not([class])) {
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .subsite-inserts :global(li:not([class])) {
    margin-bottom: 0.25rem;
  }

  .subsite-inserts :global(a:not([class])) {
    color: var(--color-galaxy-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .subsite-inserts :global(a:not([class]):hover) {
    color: var(--color-galaxy-dark);
  }

  /* Override the harsh bg-secondary on info-box cards to use Galaxy branding */
  .subsite-inserts :global(.bg-secondary) {
    background-color: #e8eef4 !important;
    border-color: #c5d4e2 !important;
  }

  .subsite-inserts :global(.bg-secondary .btn) {
    background-color: var(--color-galaxy-primary) !important;
    color: #fff !important;
    border-color: var(--color-galaxy-primary) !important;
    border-radius: 0.375rem;
  }

  .subsite-inserts :global(.bg-secondary .btn:hover) {
    background-color: #1d4261 !important;
    border-color: #1d4261 !important;
  }
</style>
