---
import type { CollectionEntry } from 'astro:content';
import PageHeader from './layout/PageHeader.astro';
import EventDate from './events/EventDate.astro';
import { formatDate } from '../utils/dateUtils';

interface Props {
  subsite: string;
  title: string;
  description: string;
  upcomingEvents: CollectionEntry<'events'>[];
  subsiteNews: CollectionEntry<'news'>[];
  hasMainContent?: boolean;
}

const { subsite, title, description, upcomingEvents, subsiteNews, hasMainContent = false } = Astro.props;
---

<div class="max-w-6xl mx-auto">
  <PageHeader {title} {description} />

  {hasMainContent && <div class="my-5 max-w-none subsite-inserts">
    <slot name="main-content" />
  </div>}

  <div class="grid gap-8 lg:grid-cols-2">
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-fg-strong">Upcoming Events</h2>
        <a
          href={`/${subsite}/events/`}
          class="text-sm font-medium text-link hover:text-link-hover hover:underline hover:decoration-link-hover-line hover:decoration-2 transition-colors"
        >
          View all →
        </a>
      </div>

      {upcomingEvents.length === 0 ? (
        <p class="text-fg-meta italic">No upcoming events.</p>
      ) : (
        <div class="space-y-3">
          {upcomingEvents.map((event) => <a
            href={`/${event.data.slug}/`}
            class="group relative block overflow-hidden p-4 bg-surface rounded-lg border border-galaxy-primary/10 shadow-sm hover:border-galaxy-primary/30 transition-all"
          >
            <span
              class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
            />
            <h3 class="font-medium text-fg-strong group-hover:text-link transition-colors line-clamp-2">
              {event.data.title}
            </h3>
            <p class="mt-1 text-sm">
              <EventDate start={event.data.date} end={event.data.end} />
            </p>
          </a>)}
        </div>
      )}
    </section>

    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-fg-strong">Recent News</h2>
        <a
          href={`/${subsite}/news/`}
          class="text-sm font-medium text-link hover:text-link-hover hover:underline hover:decoration-link-hover-line hover:decoration-2 transition-colors"
        >
          View all →
        </a>
      </div>

      {subsiteNews.length === 0 ? (
        <p class="text-fg-meta italic">No recent news.</p>
      ) : (
        <div class="space-y-3">
          {subsiteNews.map((article) => <a
            href={`/${article.data.slug}/`}
            class="group relative block overflow-hidden p-4 bg-surface rounded-lg border border-galaxy-primary/10 shadow-sm hover:border-galaxy-primary/30 transition-all"
          >
            <span
              class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
            />
            <div class="text-xs text-fg-meta mb-1">{formatDate(article.data.date)}</div>
            <h3 class="font-medium text-fg-strong group-hover:text-link transition-colors line-clamp-2">
              {article.data.title}
            </h3>
          </a>)}
        </div>
      )}
    </section>
  </div>

  <section class="mt-12 pt-8 border-t border-line">
    <h2 class="text-xl font-bold text-fg-strong mb-4">Quick Links</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a
        href={`/${subsite}/events/`}
        class="group relative overflow-hidden p-4 bg-surface border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-fg-strong">Events</h3>
        <p class="text-sm text-fg-meta">Browse all events</p>
      </a>
      <a
        href={`/${subsite}/news/`}
        class="group relative overflow-hidden p-4 bg-surface border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-fg-strong">News</h3>
        <p class="text-sm text-fg-meta">Read latest news</p>
      </a>
      <a
        href="/use/"
        class="group relative overflow-hidden p-4 bg-surface border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-fg-strong">Platforms</h3>
        <p class="text-sm text-fg-meta">Find Galaxy servers</p>
      </a>
      <a
        href="/community/"
        class="group relative overflow-hidden p-4 bg-surface border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-fg-strong">Community</h3>
        <p class="text-sm text-fg-meta">Get involved</p>
      </a>
    </div>
  </section>

  <slot name="footer-content" />
</div>

<style>
  .subsite-inserts :global(> *) {
    margin-bottom: 1.5rem;
  }

  .subsite-inserts :global(p:not([class])),
  .subsite-inserts :global(ul:not([class])),
  .subsite-inserts :global(ol:not([class])) {
    max-width: 65ch;
    line-height: 1.7;
  }

  .subsite-inserts :global(ul:not([class])) {
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .subsite-inserts :global(li:not([class])) {
    margin-bottom: 0.25rem;
  }

  .subsite-inserts :global(a:not([class])) {
    color: var(--gx-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .subsite-inserts :global(a:not([class]):hover) {
    color: var(--gx-fg-strong);
  }

  /* Override the harsh bg-secondary on info-box cards to use Galaxy branding */
  .subsite-inserts :global(.bg-secondary) {
    background-color: #e8eef4 !important;
    border-color: #c5d4e2 !important;
  }

  .subsite-inserts :global(.bg-secondary .btn) {
    background-color: var(--color-galaxy-primary) !important;
    color: #fff !important;
    border-color: var(--color-galaxy-primary) !important;
    border-radius: 0.375rem;
  }

  .subsite-inserts :global(.bg-secondary .btn:hover) {
    background-color: #1d4261 !important;
    border-color: #1d4261 !important;
  }
</style>
