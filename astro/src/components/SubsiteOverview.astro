---
import type { CollectionEntry } from 'astro:content';
import RegionBand from './layout/RegionBand.astro';
import ProjectRows, { type ProjectRow } from './projects/ProjectRows.astro';
import Icon from './mdx/Icon.astro';

interface Props {
  subsite: string;
  title: string;
  description: string;
  upcomingEvents: CollectionEntry<'events'>[];
  subsiteNews: CollectionEntry<'news'>[];
  hasMainContent?: boolean;
}

const { subsite, title, description, upcomingEvents, subsiteNews, hasMainContent = false } = Astro.props;

const moreLink =
  'text-sm font-bold text-link no-underline hover:text-link-hover hover:underline hover:decoration-link-hover-line hover:decoration-2';

// Same subsite-scoped content as /<region>/events/ and /<region>/news/, five of each
const eventRows: ProjectRow[] = upcomingEvents.map((event) => ({
  href: `/${event.data.slug}/`,
  title: event.data.title || 'Untitled event',
  tease: event.data.tease,
  start: event.data.date,
  end: event.data.end,
}));
const newsRows: ProjectRow[] = subsiteNews.map((article) => ({
  href: `/${article.data.slug}/`,
  title: article.data.title || 'Untitled',
  tease: article.data.tease,
  start: article.data.date,
}));
---

<div class="max-w-6xl mx-auto">
  <RegionBand {title} {description} />

  {hasMainContent && <div class="my-5 max-w-none subsite-inserts">
    <slot name="main-content" />
  </div>}

  <div class="region-home-grid">
    <section aria-labelledby="region-events">
      <div class="region-sec-head">
        <h2 id="region-events">Upcoming events</h2>
        <a href={`/${subsite}/events/`} class={moreLink}>
          All events <span aria-hidden="true">→</span><span class="sr-only"> from {title}</span>
        </a>
      </div>

      {eventRows.length === 0 ? (
        <div class="region-empty">
          <span class="region-empty__icon" aria-hidden="true"><Icon name="inbox" size={28} /></span>
          <p class="region-empty__title">No upcoming events</p>
          <p class="region-empty__text">New events show here once they are announced.</p>
        </div>
      ) : (
        <ProjectRows kind="events" past={false} items={eventRows} />
      )}
    </section>

    <section aria-labelledby="region-news">
      <div class="region-sec-head">
        <h2 id="region-news">Latest news</h2>
        <a href={`/${subsite}/news/`} class={moreLink}>
          All news <span aria-hidden="true">→</span><span class="sr-only"> from {title}</span>
        </a>
      </div>

      {newsRows.length === 0 ? (
        <div class="region-empty">
          <span class="region-empty__icon" aria-hidden="true"><Icon name="inbox" size={28} /></span>
          <p class="region-empty__title">No news yet</p>
          <p class="region-empty__text">News for this region shows here once it is posted.</p>
        </div>
      ) : (
        <ProjectRows kind="news" items={newsRows} />
      )}
    </section>
  </div>

  <section class="mt-12 pt-8 border-t border-ebony-clay-100">
    <h2 class="text-xl font-bold text-galaxy-dark mb-4">Quick Links</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a
        href={`/${subsite}/events/`}
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">Events</h3>
        <p class="text-sm text-chicago-600">Browse all events</p>
      </a>
      <a
        href={`/${subsite}/news/`}
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">News</h3>
        <p class="text-sm text-chicago-600">Read latest news</p>
      </a>
      <a
        href="/use/"
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">Platforms</h3>
        <p class="text-sm text-chicago-600">Find Galaxy servers</p>
      </a>
      <a
        href="/community/"
        class="group relative overflow-hidden p-4 bg-white border border-galaxy-primary/10 rounded-lg shadow-sm hover:border-galaxy-primary/30 transition-colors"
      >
        <span
          class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-gold transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-200"
        ></span>
        <h3 class="font-semibold text-galaxy-dark">Community</h3>
        <p class="text-sm text-chicago-600">Get involved</p>
      </a>
    </div>
  </section>

  <slot name="footer-content" />
</div>

<style>
  .region-home-grid {
    display: grid;
    gap: 32px 40px;
    margin-top: 32px;
  }

  @media (min-width: 1024px) {
    .region-home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Section head: h2 and "View all" over a hairline (prototype A .sec-head) */
  .region-sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--gx-line);
  }

  .region-sec-head h2 {
    margin: 0;
    font-size: var(--gx-text-h2);
    line-height: 1.3;
    font-weight: 700;
    color: var(--gx-fg-strong);
  }

  /* Empty list (prototype A .empty): the section stays, with a dashed box in place of the rows */
  .region-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 32px 20px;
    text-align: center;
    border: 1px dashed var(--gx-line-strong);
    border-radius: 0.625rem;
    background: var(--gx-surface-2);
  }

  .region-empty__icon {
    display: inline-flex;
    color: var(--gx-fg-meta);
  }

  .region-empty__title {
    margin: 0;
    font-weight: 700;
    color: var(--gx-fg-strong);
  }

  .region-empty__text {
    margin: 0;
    font-size: var(--gx-text-meta);
    line-height: 1.25rem;
    color: var(--gx-fg-meta);
  }

  .subsite-inserts :global(> *) {
    margin-bottom: 1.5rem;
  }

  .subsite-inserts :global(p:not([class])),
  .subsite-inserts :global(ul:not([class])),
  .subsite-inserts :global(ol:not([class])) {
    max-width: 65ch;
    line-height: 1.7;
  }

  .subsite-inserts :global(ul:not([class])) {
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .subsite-inserts :global(li:not([class])) {
    margin-bottom: 0.25rem;
  }

  .subsite-inserts :global(a:not([class])) {
    color: var(--color-galaxy-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .subsite-inserts :global(a:not([class]):hover) {
    color: var(--color-galaxy-dark);
  }

  /* Override the harsh bg-secondary on info-box cards to use Galaxy branding */
  .subsite-inserts :global(.bg-secondary) {
    background-color: #e8eef4 !important;
    border-color: #c5d4e2 !important;
  }

  .subsite-inserts :global(.bg-secondary .btn) {
    background-color: var(--color-galaxy-primary) !important;
    color: #fff !important;
    border-color: var(--color-galaxy-primary) !important;
    border-radius: 0.375rem;
  }

  .subsite-inserts :global(.bg-secondary .btn:hover) {
    background-color: #1d4261 !important;
    border-color: #1d4261 !important;
  }
</style>
