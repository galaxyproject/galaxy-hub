---
/**
 * CodeCopy: adds a "Copy" button to every fenced code block in article prose.
 *
 * Progressive enhancement: renders nothing server-side. On page load each
 * `.prose pre` is wrapped in a positioned container and given a button that
 * copies the block's text to the clipboard. Included by BaseLayout so every
 * route that renders prose ships both the script and the styles, and view
 * transitions between routes cannot leave a page with one but not the other.
 */
---

<style is:global>
  .code-block {
    position: relative;
  }

  /* Room for the button so it never covers the first line of code. */
  .code-block > pre {
    padding-right: 5.5rem;
  }

  .code-copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.55rem;
    font: 600 0.72rem/1 var(--font-sans, inherit);
    letter-spacing: 0.01em;
    color: #d5dbe5;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.375rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .code-copy svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .code-copy:hover,
  .code-copy:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 215, 0, 0.7);
    outline: none;
  }

  .code-copy.is-copied {
    color: #1f2937;
    background: #ffd700;
    border-color: #ffd700;
  }

  .code-copy.is-failed {
    color: #fff;
    background: #b91c1c;
    border-color: #b91c1c;
  }

  .code-copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media print {
    .code-copy {
      display: none;
    }
  }
</style>

<script>
  import { icons, svg } from '../../lib/icons';

  const LABEL_IDLE = 'Copy';
  const ARIA_IDLE = 'Copy code to clipboard';
  const FEEDBACK_MS = 1600;

  function blockText(pre: HTMLElement): string {
    const code = pre.querySelector('code') ?? pre;
    return (code.textContent ?? '').replace(/\n$/, '');
  }

  /** Copy text to the clipboard; resolves to whether it actually worked. */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        ta.remove();
        return ok;
      } catch {
        return false;
      }
    }
  }

  function setState(btn: HTMLButtonElement, state: 'idle' | 'copied' | 'failed') {
    btn.classList.toggle('is-copied', state === 'copied');
    btn.classList.toggle('is-failed', state === 'failed');
    const label = state === 'copied' ? 'Copied' : state === 'failed' ? 'Copy failed' : LABEL_IDLE;
    btn.innerHTML = `${svg(state === 'copied' ? icons.check : icons.copy)}<span>${label}</span>`;
    btn.setAttribute(
      'aria-label',
      state === 'copied' ? 'Copied code to clipboard' : state === 'failed' ? 'Copy failed' : ARIA_IDLE
    );
  }

  /** One visually hidden live region per page, announcing copy results. */
  function statusRegion(): HTMLElement {
    let el = document.querySelector<HTMLElement>('.code-copy-status');
    if (!el) {
      el = document.createElement('div');
      el.className = 'code-copy-status';
      el.setAttribute('role', 'status');
      el.setAttribute('aria-live', 'polite');
      document.body.appendChild(el);
    }
    return el;
  }

  function enhance(): void {
    document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
      if (pre.closest('.code-block') || pre.closest('.not-prose')) return;
      if (!blockText(pre).trim()) return;

      // Move the block's own margins to the wrapper so nothing shifts on load.
      const cs = getComputedStyle(pre);
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      wrap.style.marginTop = cs.marginTop;
      wrap.style.marginBottom = cs.marginBottom;
      pre.style.marginTop = '0';
      pre.style.marginBottom = '0';
      pre.replaceWith(wrap);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      setState(btn, 'idle');
      wrap.appendChild(btn);
    });
  }

  let timer: ReturnType<typeof setTimeout> | undefined;

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.code-copy');
    if (!btn) return;
    const pre = btn.parentElement?.querySelector<HTMLElement>('pre');
    if (!pre) return;
    const ok = await copyText(blockText(pre));
    document.querySelectorAll<HTMLButtonElement>('.code-copy.is-copied, .code-copy.is-failed').forEach((b) => {
      if (b !== btn) setState(b, 'idle');
    });
    setState(btn, ok ? 'copied' : 'failed');
    statusRegion().textContent = ok ? 'Copied to clipboard' : 'Copy failed';
    clearTimeout(timer);
    timer = setTimeout(() => setState(btn, 'idle'), FEEDBACK_MS);
  });

  document.addEventListener('astro:page-load', enhance);
</script>
