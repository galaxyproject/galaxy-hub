@article{vong_beta_2019,
	title = {Beta vulgaris mitovirus 1 in diverse cultivars of beet and chard},
	volume = {265},
	issn = {0168-1702},
	url = {http://www.sciencedirect.com/science/article/pii/S0168170218307184},
	doi = {10.1016/j.virusres.2019.02.008},
	abstract = {Recent results indicate that mitoviruses, which replicate persistently in host mitochondria, are not restricted to fungi, but instead are found also in plants. Beta vulgaris mitovirus 1 (BevuMV1) is an example first discovered in sugar beet cultivars. For the current study, complete coding sequences of 42 BevuMV1 strains were newly determined, derived from not only sugar beet but also fodder beet, table beet, and Swiss chard cultivars of Beta vulgaris, as well as wild sea beet. BevuMV1 is thus a common phytobiome component of this valuable crop species. Most of the new BevuMV1 sequences originated from RNA extracted from B. vulgaris seed clusters, consistent with vertical transmission of this virus. Results suggest that BevuMV1 entered the B. vulgaris lineage prior to human cultivation and also provides a marker for tracing the maternal ancestry of B. vulgaris cultivars. Especially notable is the monophyletic relationship and limited sequence divergence among BevuMV1 strains from cultivars that are thought or shown to share the “Owen” trait for cytoplasmic male sterility, which is transmitted by maternal mitochondria and has been broadly established in commercial breeding lines of B. vulgaris since the mid-20th century.},
	urldate = {2019-03-21},
	journal = {Virus Research},
	author = {Vong, Minh and Manny, Austin R. and Smith, Kathryn L. and Gao, William and Nibert, Max L.},
	month = may,
	year = {2019},
	keywords = {+RefPublic, {\textgreater}Pasteur, Cytoplasmic male sterility, Mitochondrion, Plant virus},
	pages = {80--87},
}

@incollection{modarres_chapter_2019,
	title = {Chapter 2 - {Proteomics} and {Protein} {Interaction} in {Molecular} {Cell} {Signaling} {Pathways}},
	isbn = {978-0-12-809556-0},
	url = {http://www.sciencedirect.com/science/article/pii/B9780128095560000022},
	doi = {10.1016/B978-0-12-809556-0.00002-2},
	abstract = {New and emerging high-throughput sequencing and analysis techniques have provided unprecedented insights into the nature of the living cells, in particular, the sequences and partnership of intracellular and extracellular proteins. In addition to unlocking the sequence of proteins, gaining knowledge about the function and structures of the proteins has provided precious means not only for understanding the nature of the living cells, but also as guidelines to predicting functions of the protein sequences with unknown structure and functions. The purpose of this chapter is to present a general introduction to proteomics, followed by the examination of modern proteomics studies and next-generation sequencing techniques. A comprehensive list of corresponding databases and tools is provided to facilitate further exploration by interested readers.},
	urldate = {2018-12-18},
