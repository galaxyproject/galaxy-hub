@article{lopes_co-expression_2023,
	title = {Co-expression analysis of {lncRNA} and {mRNA} identifies potential adipogenesis regulatory non-coding {RNAs} involved in the transgenerational effects of tributyltin},
	volume = {18},
	issn = {1932-6203},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0281240},
	doi = {10.1371/journal.pone.0281240},
	abstract = {The obesity epidemic is considered a global public health crisis, with an increase in caloric intake, sedentary lifestyles and/or genetic predispositions as contributing factors. Although the positive energy balance is one of the most significant causes of obesity, recent research has linked early exposure to Endocrine-Disrupting Chemicals (EDCs) such as the obesogen tributyltin (TBT) to the disease epidemic. In addition to their actions on the hormonal profile, EDCs can induce long-term changes in gene expression, possibly due to changes in epigenetic patterns. Long non-coding RNAs (lncRNAs) are epigenetic mediators that play important regulatory roles in several biological processes, through regulation of gene transcription and/or translation. In this study, we explored the differential expression of lncRNAs in gonadal white adipose tissue samples from adult male C57BL/6J F4 generation, female C57BL/6J offspring exposed (F0 generation) to 50 nM TBT or 0.1\% DMSO (control of vehicle) via drinking water provided during pregnancy and lactation, analyzing RNA-seq data from a publicly available dataset (GSE105051). A total of 74 lncRNAs were differentially expressed (DE), 22 were up-regulated and 52 were down-regulated in the group whose F4 ancestor was exposed in utero to 50nM TBT when compared to those exposed to 0.1\% DMSO (control). Regulation of DE lncRNAs and their potential partner genes in gonadal white adipose tissue of mice ancestrally exposed to EDC TBT may be related to the control of adipogenesis, as pathway enrichment analyses showed that these gene partners are mainly involved in the metabolism of lipids and glucose and in insulin-related pathways, which are essential for obesity onset and control.},
	language = {en},
	number = {2},
	urldate = {2023-10-28},
	journal = {PLOS ONE},
	publisher = {Public Library of Science},
	author = {Lopes, Maria Fernanda da Silva and Felix, Juliana de Souza and Scaramele, Natália Francisco and Almeida, Mariana Cordeiro and Furlan, Amanda de Oliveira and Troiano, Jéssica Antonini and Athayde, Flávia Regina Florêncio de and Lopes, Flávia Lombardi},
	month = mar,
	year = {2023},
	keywords = {{\textgreater}UseGalaxy.org, Adipose tissue, DNA methylation, Epigenetics, Gene expression, Gene regulation, Glucose metabolism, Long non-coding RNA, Obesity},
	pages = {e0281240},
}

@article{toh_sequential_2023,
	title = {Sequential infection of human norovirus and {Salmonella} enterica resulted in higher mortality and {ACOD1}/{IRG1} upregulation in zebrafish larvae},
	issn = {1286-4579},
	url = {https://www.sciencedirect.com/science/article/pii/S1286457923001326},
	doi = {10.1016/j.micinf.2023.105229},
	abstract = {Human norovirus (HNoVs) and Salmonella are both very important foodborne pathogens with mixed infection of HNoV and Salmonella reported clinically. With the use of model organism zebrafish (Danio rerio), it was observed that the sequential infection of HNoVs and Salmonella caused lower survival rates (12.5 ± 4.2\%) than the single-pathogen infection by Salmonella (31.6 ± 7.3\%, P {\textless} 0.05) or HNoVs (no mortality observed). Gene expression study with the use of RT-PCR and global transcriptomic analysis revealed that the mortality of zebrafish larvae was very likely due to the harmful inflammatory responses. Specifically, it was noted that the genes encoding aconitate decarboxylase 1 (ACOD1), also known as immunoresponsive gene 1 (IRG1), were significantly upregulated in the sequentially infected zebrafish larvae. The expression of acod1 could lead to mitochondrial reactive oxygen species (ROS) production. The ROS levels were indeed higher in sequentially infected zebrafish larvae than the single-pathogen infected ones (P {\textless} 0.05). An immersion treatment of glutathione or citraconate did not affect the microbial loads of HNoVs and Salmonella but significantly reduced the ROS levels and protected the zebrafish larvae by inducing higher survival rates in the sequentially infected zebrafish larvae (P {\textless} 0.05). Taken together, this study accumulated new knowledge over the function of ACOD1/IRG1 pathway in infectious diseases, and proposed possible treatment strategies accordingly.},
	urldate = {2023-10-28},
	journal = {Microbes and Infection},
	author = {Toh, Jillinda Yi Ling and Zwe, Ye Htut and Tan, Malcolm Turk Hsern and Gong, Zhiyuan and Li, Dan},
	month = sep,
	year = {2023},
	keywords = {/IRG1, {\textgreater}UseGalaxy.org, Human norovirus, Infection, ROS, Zebrafish},
	pages = {105229},
}

