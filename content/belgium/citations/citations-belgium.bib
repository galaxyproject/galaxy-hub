@article{mehta_precursor_2020,
	title = {Precursor {Intensity}-{Based} {Label}-{Free} {Quantification} {Software} {Tools} for {Proteomic} and {Multi}-{Omic} {Analysis} within the {Galaxy} {Platform}},
	volume = {8},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2227-7382},
	url = {https://www.mdpi.com/2227-7382/8/3/15},
	doi = {10.3390/proteomes8030015},
	abstract = {For mass spectrometry-based peptide and protein quantification, label-free quantification (LFQ) based on precursor mass peak (MS1) intensities is considered reliable due to its dynamic range, reproducibility, and accuracy. LFQ enables peptide-level quantitation, which is useful in proteomics (analyzing peptides carrying post-translational modifications) and multi-omics studies such as metaproteomics (analyzing taxon-specific microbial peptides) and proteogenomics (analyzing non-canonical sequences). Bioinformatics workflows accessible via the Galaxy platform have proven useful for analysis of such complex multi-omic studies. However, workflows within the Galaxy platform have lacked well-tested LFQ tools. In this study, we have evaluated moFF and FlashLFQ, two open-source LFQ tools, and implemented them within the Galaxy platform to offer access and use via established workflows. Through rigorous testing and communication with the tool developers, we have optimized the performance of each tool. Software features evaluated include: (a) match-between-runs (MBR); (b) using multiple file-formats as input for improved quantification; (c) use of containers and/or conda packages; (d) parameters needed for analyzing large datasets; and (e) optimization and validation of software performance. This work establishes a process for software implementation, optimization, and validation, and offers access to two robust software tools for LFQ-based analysis within the Galaxy platform.},
	language = {en},
	number = {3},
	urldate = {2021-05-04},
	journal = {Proteomes},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Mehta, Subina and Easterly, Caleb W. and Sajulga, Ray and Millikin, Robert J. and Argentini, Andrea and Eguinoa, Ignacio and Martens, Lennart and Shortreed, Michael R. and Smith, Lloyd M. and McGowan, Thomas and Kumar, Praveen and Johnson, James E. and Griffin, Timothy J. and Jagtap, Pratik D.},
	month = sep,
	year = {2020},
	note = {Number: 3},
	keywords = {+Galactic, +Tools, {\textgreater}Galaxy-P, {\textgreater}UseGalaxy.be, {\textgreater}UseGalaxy.eu, galaxy framework, label-free quantification, proteomics, workflows},
	pages = {15},
}

@article{baker_no_2020,
	title = {No more business as usual: {Agile} and effective responses to emerging pathogen threats require open data and open analytics},
	volume = {16},
	issn = {1553-7374},
	shorttitle = {No more business as usual},
	url = {https://journals.plos.org/plospathogens/article?id=10.1371/journal.ppat.1008643},
	doi = {10.1371/journal.ppat.1008643},
	abstract = {The current state of much of the Wuhan pneumonia virus (severe acute respiratory syndrome coronavirus 2 [SARS-CoV-2]) research shows a regrettable lack of data sharing and considerable analytical obfuscation. This impedes global research cooperation, which is essential for tackling public health emergencies and requires unimpeded access to data, analysis tools, and computational infrastructure. Here, we show that community efforts in developing open analytical software tools over the past 10 years, combined with national investments into scientific computational infrastructure, can overcome these deficiencies and provide an accessible platform for tackling global health emergencies in an open and transparent manner. Specifically, we use all SARS-CoV-2 genomic data available in the public domain so far to (1) underscore the importance of access to raw data and (2) demonstrate that existing community efforts in curation and deployment of biomedical software can reliably support rapid, reproducible research during global health crises. All our analyses are fully documented at https://github.com/galaxyproject/SARS-CoV-2.},
	language = {en},
	number = {8},
	urldate = {2020-08-30},
	journal = {PLOS Pathogens},
	publisher = {Public Library of Science},
	author = {Baker, Dannon and Beek, Marius van den and Blankenberg, Daniel and Bouvier, Dave and Chilton, John and Coraor, Nate and Coppens, Frederik and Eguinoa, Ignacio and Gladman, Simon and Grüning, Björn and Keener, Nicholas and Larivière, Delphine and Lonie, Andrew and Pond, Sergei Kosakovsky and Maier, Wolfgang and Nekrutenko, Anton and Taylor, James and Weaver, Steven},
	month = aug,
	year = {2020},
	keywords = {+Galactic, +IsGalaxy, +Methods, +Project, +Reproducibility, +Shared, +UseMain, +UsePublic, {\textgreater}UseGalaxy.be, {\textgreater}UseGalaxy.eu, {\textgreater}UseGalaxy.org.au, COVID 19, Genome analysis, Genomics, Open source software, Preprocessing, Public Health, SARS, SARS CoV 2, Transmissible gastroenteritis coronavirus},
	pages = {e1008643},
}

@article{van_rossum_genetic_2024,
	title = {Genetic diversity assessment of \&lt;i\&gt;{Helichrysum} arenarium\&lt;/i\&gt; ({Asteraceae}) for the genetic restoration of declining populations},
	volume = {14},
	copyright = {cc by},
	issn = {2045-7758},
	url = {https://europepmc.org/articles/PMC10869947},
	doi = {10.1002/ece3.10953},
	abstract = {Helichrysum arenarium (L.) Moench (Asteraceae) is a self-compatible, insect-pollinated herb occurring in sand grasslands, and is declining and endangered in many parts of its European distribution range. A recovery plan of H. arenarium has been conducted in southern Belgium, involving plant translocations. We developed multiplex genotyping protocol for nine microsatellite markers previously published for Helichrysum italicum and two newly developed microsatellite markers for H. arenarium. Eleven polymorphic loci were associated (pooled) in two multiplex panels, to assess the genetic status of the only small remaining population in Belgium and of three large German populations used as seed source for propagating transplants. The small Belgian population was characterized by high clonality, with only two, however heterozygous, genets detected. The three large German populations showed high genetic diversity (H e ranging from 0.635 to 0.670) and no significant inbreeding coefficient values, despite expectations of geitonogamous selfing. Management practices (grazing livestock) increasing seed dispersal distances, inbreeding depression at early stages of development, and mechanisms preventing or delaying selfing might be hypothesized to explain the observed patterns. The two Belgian genotypes remained within genetic variation range of German populations so that the high genetic differentiation between Belgian and German populations (F ST values ranging from 0.186 to 0.206) likely resulted from genetic drift effects and small sample size. Transplants obtained from seeds sampled from the three large source populations from Germany constitute a highly diverse, noninbred gene pool, and are thus of high genetic quality for plant translocations.},
	language = {eng},
	number = {2},
	urldate = {2025-01-13},
	journal = {Ecology and evolution},
	author = {Van Rossum, Fabienne and Godé, Cécile and Baruca Arbeiter, Alenka and Raspé, Olivier and Simsek, Melike and Barigand, Benjamin and Hardy, Olivier J and Bandelj, Dunja},
	month = feb,
	year = {2024},
	keywords = {{\textgreater}UseGalaxy.be, Endangered species, Geitonogamous selfing, Genetic Restoration, Helichrysum Arenarium (L). Moench, Plant Translocations},
	pages = {e10953},
}

@article{aparicio_chacon_exploring_2024,
	title = {Exploring the potential role of four {Rhizophagus} irregularis nuclear effectors: opportunities and technical limitations},
	volume = {15},
	issn = {1664-462X},
	shorttitle = {Exploring the potential role of four {Rhizophagus} irregularis nuclear effectors},
	url = {https://www.frontiersin.org/journals/plant-science/articles/10.3389/fpls.2024.1384496/full},
	doi = {10.3389/fpls.2024.1384496},
	abstract = {{\textless}p{\textgreater}Arbuscular mycorrhizal fungi (AMF) are obligate symbionts that interact with the roots of most land plants. The genome of the AMF model species {\textless}italic{\textgreater}Rhizophagus irregularis{\textless}/italic{\textgreater} contains hundreds of predicted small effector proteins that are secreted extracellularly but also into the plant cells to suppress plant immunity and modify plant physiology to establish a niche for growth. Here, we investigated the role of four nuclear-localized putative effectors, {\textless}italic{\textgreater}i.e.{\textless}/italic{\textgreater}, GLOIN707, GLOIN781, GLOIN261, and RiSP749, in mycorrhization and plant growth. We initially intended to execute the functional studies in {\textless}italic{\textgreater}Solanum lycopersicum{\textless}/italic{\textgreater}, a host plant of economic interest not previously used for AMF effector biology, but extended our studies to the model host {\textless}italic{\textgreater}Medicago truncatula{\textless}/italic{\textgreater} as well as the non-host {\textless}italic{\textgreater}Arabidopsis thaliana{\textless}/italic{\textgreater} because of the technical advantages of working with these models. Furthermore, for three effectors, the implementation of reverse genetic tools, yeast two-hybrid screening and whole-genome transcriptome analysis revealed potential host plant nuclear targets and the downstream triggered transcriptional responses. We identified and validated a host protein interactors participating in mycorrhization in the host.{\textless}italic{\textgreater}S. lycopersicum{\textless}/italic{\textgreater} and demonstrated by transcriptomics the effectors possible involvement in different molecular processes, {\textless}italic{\textgreater}i.e.{\textless}/italic{\textgreater}, the regulation of DNA replication, methylglyoxal detoxification, and RNA splicing. We conclude that {\textless}italic{\textgreater}R. irregularis{\textless}/italic{\textgreater} nuclear-localized effector proteins may act on different pathways to modulate symbiosis and plant physiology and discuss the pros and cons of the tools used.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2024-04-27},
	journal = {Frontiers in Plant Science},
	publisher = {Frontiers},
	author = {Aparicio Chacón, María Victoria and Hernández Luelmo, Sofía and Devlieghere, Viktor and Robichez, Louis and Leroy, Toon and Stuer, Naomi and De Keyser, Annick and Ceulemans, Evi and Goossens, Alain and Goormachtig, Sofie and Van Dingenen, Judith},
	month = apr,
	year = {2024},
	keywords = {{\textgreater}UseGalaxy.be, Arbuscular Mycorrhizal Symbiosis, Effectors, Mycorrhization, Plant Growth, Rhizophagus irregularis, nuclear effector proteins, protein-protein interaction, transcriptional responses},
}
