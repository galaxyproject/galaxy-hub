@incollection{choudhari_chapter_2021,
	title = {Chapter 24 - {Advanced} {Omics} {Technologies}: {Relevant} to {Environment} and {Microbial} {Community}},
	isbn = {978-0-12-821881-5},
	shorttitle = {Chapter 24 - {Advanced} {Omics} {Technologies}},
	url = {https://www.sciencedirect.com/science/article/pii/B9780128218815000246},
	doi = {10.1016/B978-0-12-821881-5.00024-6},
	abstract = {Microorganisms, the primary workforce of environment health, rarely exist as single genetically ideal population and rather live in combinations. To get an insight into the structure and functional analysis of this vast microbial world, traditional cultivation-dependent methods are inadequate and it demands efficient tools for analysis of huge data in a short period. Genomics, transcriptomics, proteomics, epigenomics, metagenomics, etc., are collectively referred to as omics. Due to the hugeness of omics data, analyses often pose great informatics challenges. To overcome this issue various research teams have developed tools collectively called omics tool for better and quick understanding of omics including dynamic behavior of genes, cells, tissues, organs, and the whole organism at the molecular level. The most used technologies are systems biology, bioinformatics, as well as the computational tools to analyze and make sense of the data. Among the various tools developed and in work, few to name are MEGAN, MG-RAST, Mothur, UPARSE, DADA2, MED, Obitool, REINSEQ, CLC Microbial Genomics Module, MicrobiomeAnalyst, METAGENassist, EBI-Metagenomics, QIIME MG-RAST, VAMPS, PICRUSt, BURRITO, and MicrobesOnline. In this chapter authors attempt to describe importance of the omics tool in the first section; the second section contains illustration of present most utilized omics tools and their application for the study of microbes in environment. In the third section, tool MG-RAST is used for taxonomic and functional analysis of metagenome dataset as an example for a better understanding of the tool utilization.},
	language = {en},
	urldate = {2021-07-18},
	booktitle = {Wastewater {Treatment}},
	publisher = {Elsevier},
	author = {Choudhari, J. K. and Verma, M. K. and Choubey, J. and Banerjee, A. and Sahariah, B. P.},
	editor = {Shah, Maulin P. and Sarkar, Angana and Mandal, Sukhendu},
	month = jan,
	year = {2021},
	keywords = {+Tools, {\textgreater}GenOuest, Omics technology, bioinformatics, environment health, microbes, systems biology},
	pages = {489--506},
}

@article{enriquez_cold_2019,
	title = {Cold acclimation triggers major transcriptional changes in {Drosophila} suzukii},
	volume = {20},
	issn = {1471-2164},
	url = {https://doi.org/10.1186/s12864-019-5745-7},
	doi = {10.1186/s12864-019-5745-7},
	abstract = {Insects have the capacity to adjust their physiological mechanisms during their lifetime to promote cold tolerance and cope with sublethal thermal conditions, a phenomenon referred to as thermal acclimation. The spotted wing drosophila, Drosophila suzukii, is an invasive fruit pest that, like many other species, enhances its thermotolerance in response to thermal acclimation. However, little is known about the underlying mechanisms of this plastic response. Here, we promoted flies’ cold tolerance by gradually increasing acclimation duration (i.e. pre-exposure from 2 h to 9 days at 10 °C), and then compared transcriptomic responses of cold hardy versus cold susceptible phenotypes using RNA sequencing.},
	number = {1},
	urldate = {2019-06-19},
	journal = {BMC Genomics},
	author = {Enriquez, Thomas and Colinet, Hervé},
	month = may,
	year = {2019},
	keywords = {+Methods, +UsePublic, {\textgreater}GenOuest},
	pages = {413},
}

@article{melaine_deciphering_2018,
	title = {Deciphering the {Dark} {Proteome}: {Use} of the {Testis} and {Characterization} of {Two} {Dark} {Proteins}},
	issn = {1535-3893},
	shorttitle = {Deciphering the {Dark} {Proteome}},
	url = {https://doi.org/10.1021/acs.jproteome.8b00387},
	doi = {10.1021/acs.jproteome.8b00387},
	abstract = {For the C-HPP consortium, dark proteins include not only uPE1, but also missing proteins (MPs, PE2–4), smORFs, proteins from lncRNAs, and products from uncharacterized transcripts. Here, we investigated the expression of dark proteins in the human testis by combining public mRNA and protein expression data for several tissues and performing LC–MS/MS analysis of testis protein extracts. Most uncharacterized proteins are highly expressed in the testis. Thirty could be identified in our data set, of which two were selected for further analyses: (1) A0AOU1RQG5, a putative cancer/testis antigen specifically expressed in the testis, where it accumulates in the cytoplasm of elongated spermatids; and (2) PNMA6E, which is enriched in the testis, where it is found in the germ cell nuclei during most stages of spermatogenesis. Both proteins are coded on Chromosome X. Finally, we studied the expression of other dark proteins, uPE1 and MPs, in a series of human tissues. Most were highly expressed in the testis at both the mRNA and protein levels. The testis appears to be a relevant organ to study the dark proteome, which may have a function related to spermatogenesis and germ cell differentiation. The mass spectrometry proteomics data have been deposited with the ProteomeXchange Consortium under the data set identifier PXD009598.},
	urldate = {2018-09-14},
	journal = {Journal of Proteome Research},
	author = {Melaine, Nathalie and Com, Emmanuelle and Bellaud, Pascale and Guillot, Laetitia and Lagarrigue, Mélanie and Morrice, Nick A. and Guével, Blandine and Lavigne, Régis and Velez de la Calle, Juan-Felipe and Dojahn, Jörg and Pineau, Charles},
	month = aug,
	year = {2018},
	keywords = {+Methods, +UsePublic, {\textgreater}GenOuest},
}
